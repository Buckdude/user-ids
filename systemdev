            const fontSizes = {
            1: 1.10,
            2: 0.98,
            3: 0.94,
            4: 0.90
            };

            const startingSize = reportPopupReasonBaseFontSize * fontSizes[Math.min(reportPopupReasonCount, 4)];
            reason.style.fontSize = `${startingSize}px`;
            const measure = document.createElement('span');
            measure.textContent = reason.textContent;
            measure.style.cssText = 'position: absolute; display: inline-block; width: max-content; max-width: none; white-space: nowrap; visibility: hidden; pointer-events: none;';
