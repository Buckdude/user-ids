            @keyframes ss-modchat-flash { 0%, 100% {color:#ffffff;} 50% {color:#fff100;} }
            #custom-reports-panel #ss-modchat-toggle .ss-modchat-badge {
                position:absolute; top:-7px; right:-9px; display:none; align-items:center; justify-content:center;
                min-width:calc(15 * var(--ss-report-unit)); height:calc(15 * var(--ss-report-unit));
                padding:0 2px; border-radius:9px; background:#fff100; color:#0c576f !important;
                font:700 calc(10 * var(--ss-report-unit))/1 Arial,sans-serif !important;
                text-shadow:none !important; box-sizing:border-box;
            }
            #custom-reports-panel .ss-modchat-window {display:none; flex-direction:column; min-height:0; width:100%;background:#06baf7;}
            #custom-reports-panel.ss-modchat-active .ss-modchat-window {display:flex !important;}
            #custom-reports-panel.ss-modchat-active .news-container {display:none !important;}
            #custom-reports-panel.ss-modchat-active #ss-reports-count,
            #custom-reports-panel.ss-modchat-active #ss-action-count,
            #custom-reports-panel.ss-modchat-active #ss-reports-discord-copy {display:none !important;}
            #custom-reports-panel #ss-modchat-older {
                width:100%; background:transparent; color:#0c576f; border:0; cursor:pointer;
                font-size:calc(10 * var(--ss-report-unit)); font-weight:700; padding:3px; min-height:20px;
            }
            #custom-reports-panel #ss-modchat-messages {
                display:flex; flex-direction:column; gap:4px; min-height:0; max-height:170px;
                overflow-y:auto; overflow-x:hidden; padding:6px 7px; box-sizing:border-box;
                background:#06baf7; font:calc(10 * var(--ss-report-unit))/1.3 Arial,sans-serif;
                color:#0c576f; overflow-wrap:anywhere; white-space:pre-wrap;
            }
            #custom-reports-panel .ss-modchat-message {display:flex; flex-direction:column; align-items:flex-start; gap:2px; width:100%;}
            #custom-reports-panel .ss-modchat-message-header {display:flex; flex-wrap:wrap; align-items:center; gap:3px; width:100%;}
            #custom-reports-panel .ss-modchat-message strong {font-weight:800;color:#0c576f;}
            #custom-reports-panel .ss-modchat-message .ss-modchat-body {display:block; width:100%; color:#123d54; white-space:pre-wrap;}
            #custom-reports-panel .ss-modchat-author-tags {display:inline-flex; align-items:center; flex-wrap:wrap; gap:2px;}
            #custom-reports-panel .ss-modchat-tag {box-shadow:none !important; text-shadow:none !important; font-size:calc(8 * var(--ss-report-unit)) !important; padding:calc(1 * var(--ss-report-unit)) calc(4 * var(--ss-report-unit)) !important;}
            #custom-reports-panel .ss-modchat-tag[role="button"] {cursor:pointer;}
            #custom-reports-panel .ss-modchat-time {cursor:default;}
            #custom-reports-panel .ss-modchat-empty {font-weight:700;text-align:center;padding:10px 0;}
            #custom-reports-panel #ss-modchat-status {
                display:none; padding:4px 8px; color:#9b1818; font:700 calc(10 * var(--ss-report-unit)) Arial,sans-serif;
            }
            #custom-reports-panel .ss-modchat-compose {display:block; padding:3px 6px;}
            #custom-reports-panel #ss-modchat-input.chat.roundme_sm {
                display:block !important; width:100% !important; min-width:0; box-sizing:border-box;
                min-height:27px; margin:0; padding:4px 6px; outline:none;
                pointer-events:auto !important; border:0 !important; border-radius:8px;
                background:transparent !important; color:#ffffff !important;
                font-family:Nunito,Arial,sans-serif !important; font-size:calc(14 * var(--ss-report-unit)) !important;
                font-weight:700 !important; line-height:1.2 !important;
