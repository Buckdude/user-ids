        badge.style.setProperty('background', tag.backgroundColor, 'important');
        if (identity) {
            const action = getBadgeAction(tag, identity);
            badge.setAttribute('role', 'button');
            badge.tabIndex = 0;
            badge.title = action.link ? 'Open link' : 'Copy Discord ID';
            const activate = event => {
