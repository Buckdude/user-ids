        function getReportPopupZoom() {
            const browserZoom = window.devicePixelRatio || 1;
            const viewportZoom = window.visualViewport?.scale || 1;
            const zoom = browserZoom * viewportZoom;
            return Number.isFinite(zoom) && zoom > 0 ? zoom : 1;
        }

        function getReportPopupContentWidth(popup) {
            let width = 245;
            for (const selector of ['#report_popup_user_tags', '#report_popup_reporter_tags']) {
                const tags = popup.querySelector(selector);
                if (!tags || tags.style.display === 'none') continue;
                let rowWidth = 0;
                let tagsInRow = 0;
                for (const tag of tags.children) {
                    if (tag.classList.contains('ss-report-tag-row-break')) {
                        width = Math.max(width, rowWidth + 32);
                        rowWidth = 0;
                        tagsInRow = 0;
                    } else if (tag.style.display !== 'none') {
                        rowWidth += tag.offsetWidth + (tagsInRow ? 6 : 0);
                        tagsInRow++;
                    }
                }
                width = Math.max(width, rowWidth + 32);
            }
            for (const element of popup.querySelectorAll('.ss-report-popup-buttons button, #report_popup_server, #report_popup_time, #report_popup_reporter, #report_popup_name_label')) {
                if (element.style.display !== 'none') width = Math.max(width, element.offsetWidth + 32);
            }
            const actions = popup.querySelector('.ss-report-popup-quick');
            if (actions) {
                const items = Array.from(actions.children);
                const actionsWidth = items.reduce((total, item) => total + item.offsetWidth, 0) + Math.max(0, items.length - 1) * 6;
                width = Math.max(width, actionsWidth + 32);
            }
            return width;
        }

        function keepReportPopupSize() {
            const popup = document.getElementById('reportInfoPopup');
            if (!popup || popup.style.display === 'none') return;
            lockReportPopupContents(popup);

            if (!reportPopupSizeState || reportPopupSizeState.popup !== popup) {
                const computed = getComputedStyle(popup);
                const bounds = popup.getBoundingClientRect();
                const width = Number.parseFloat(computed.width);
                if (!bounds.width || !Number.isFinite(width) || width <= 0) return;
                const matrix = computed.transform.match(/^matrix\(([^)]+)\)$/);
                const values = matrix ? matrix[1].split(',').map(Number) : [];
                const originalScale = values.length === 6 ? Math.hypot(values[0], values[1]) : 1;
                reportPopupSizeState = {
                    popup,
                    zoom: getReportPopupZoom(),
                    width,
                    x: (bounds.left + bounds.width / 2) / window.innerWidth * 100,
                    y: (bounds.top + bounds.height / 2) / window.innerHeight * 100,
                    scale: originalScale,
                    position: popup.style.position,
                    left: popup.style.left,
                    top: popup.style.top,
                    transform: popup.style.transform,
                    transformOrigin: popup.style.transformOrigin,
                    maxHeight: popup.style.maxHeight
                };
                popup.style.width = `${width}px`;
                popup.style.maxWidth = `${width}px`;
                popup.style.fontSize = computed.fontSize;
            }

            const original = reportPopupSizeState;
            const scale = 1;
            const body = popup.querySelector('.ss-report-popup-body');
            if (body) {
                body.style.width = reportPopupReasonCount >= 4 ? '100%' : '';
                body.style.boxSizing = reportPopupReasonCount >= 4 ? 'border-box' : '';
            }
            const visualScale = Math.max(0.01, original.scale * scale);
            const maximumWidth = Math.max(1, (window.innerWidth - 24) / visualScale);
            const contentWidth = getReportPopupContentWidth(popup);
            const normalWidth = reportPopupReasonCount >= 4 ? original.width : contentWidth;
            let wantedWidth = Math.min(maximumWidth, Math.max(normalWidth, reportPopupReasonRequiredWidth));
            popup.style.width = `${wantedWidth}px`;
            popup.style.maxWidth = `${wantedWidth}px`;
            const quickActions = popup.querySelector('.ss-report-popup-quick');
            if (quickActions && quickActions.scrollWidth > quickActions.clientWidth) {
                wantedWidth = Math.min(maximumWidth, wantedWidth + quickActions.scrollWidth - quickActions.clientWidth + 2);
                popup.style.width = `${wantedWidth}px`;
                popup.style.maxWidth = `${wantedWidth}px`;
            }
            if (Math.abs(scale - 1) < 0.005) {
                popup.style.position = original.position;
                popup.style.left = original.left;
                popup.style.top = original.top;
                popup.style.transform = original.transform;
                popup.style.transformOrigin = original.transformOrigin;
                popup.style.maxHeight = original.maxHeight;
            } else {
                popup.style.position = 'fixed';
                popup.style.left = `${original.x}%`;
                popup.style.top = `${original.y}%`;
                popup.style.transformOrigin = 'center center';
                popup.style.transform = `translate(-50%, -50%) scale(${original.scale * scale})`;
                popup.style.maxHeight = `${Math.max(1, window.innerHeight - 20) / scale}px`;
            }
        }

        let reportPopupReasonBaseFontSize = null;
        function fitReportPopupReason(reason) {
            if (!reason) return;
            if (reportPopupReasonBaseFontSize === null) {
                const previous = reason.style.getPropertyValue('font-size');
                const priority = reason.style.getPropertyPriority('font-size');
                reason.style.removeProperty('font-size');
                reportPopupReasonBaseFontSize = Number.parseFloat(getComputedStyle(reason).fontSize) || 16;
                if (previous) reason.style.setProperty('font-size', previous, priority);
            }
            reason.style.display = 'block';
            reason.style.boxSizing = 'border-box';
            reason.style.width = '100%';
            reason.style.minWidth = '0';
            reason.style.maxWidth = '100%';
            reason.style.whiteSpace = 'nowrap';
            reason.style.textAlign = 'center';
            reason.style.overflow = 'hidden';

            const fontSizes = {
            1: 1.10,
            2: 0.98,
            3: 0.94,
            4: 0.90
            };

            const startingSize = reportPopupReasonBaseFontSize * fontSizes[Math.min(reportPopupReasonCount, 4)];
            reason.style.fontSize = `${startingSize}px`;
            const measure = document.createElement('span');
            measure.textContent = reason.textContent;
            measure.style.cssText = 'position: absolute; display: inline-block; width: max-content; max-width: none; white-space: nowrap; visibility: hidden; pointer-events: none;';
            reason.appendChild(measure);
            const textWidth = measure.offsetWidth;
            measure.remove();

            const popup = document.getElementById('reportInfoPopup');
            if (!popup || !reportPopupSizeState) return;
            const gutter = Math.max(0, popup.offsetWidth - reason.clientWidth);
            reportPopupReasonRequiredWidth = reportPopupReasonCount >= 4 ? textWidth + gutter + 22 : 0;
            keepReportPopupSize();

            const availableWidth = Math.max(1, reason.clientWidth - 12);
            if (textWidth > availableWidth) {
                reason.style.fontSize = `${startingSize * availableWidth / textWidth}px`;
            }
        }

