        if (!rawPlayers) return false;
        let players;
        try { players = parseDirectoryJson(rawPlayers).players; }
        catch (_) { return false; }
        if (!players || typeof players !== 'object') return false;
        const verifiedURL = getRawLink(hub.GITHUB_VERIFIED_URL);
        const rawVerified = verifiedURL
            ? String(GM_getValue('ss-live-reports-verified-names:' + encodeURIComponent(verifiedURL), '') || '') : '';
        const rawTags = String(GM_getValue(TAGS_CACHE_KEY, '') || '');
        if (!rawTags) return false;
        const sourceSignature = JSON.stringify([usersURL, rawPlayers, rawVerified, rawTags]);
        if (sourceSignature === lastCachedIdentitySource) return true;
        let verified = {};
