                'border-top-left-radius', 'border-top-right-radius',
                'border-bottom-right-radius', 'border-bottom-left-radius'
            ];
            const px = /^-?\d+(?:\.\d+)?px$/;
            for (const element of [popup, ...popup.querySelectorAll('*')]) {
                const computed = getComputedStyle(element);
                for (const property of metricProperties) {
                    const value = computed.getPropertyValue(property).trim();
                    if (px.test(value)) element.style.setProperty(property, value, 'important');
                }
                if (element.matches('button')) {
                    const width = computed.width.trim();
                    if (px.test(width) && Number.parseFloat(width) > 0)
