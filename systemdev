            return `<span class="ss-report-tag ss-report-tag-nametag ss-report-name-badge ss-report-config-badge${reportsView === 'reports' ? ' ss-report-flash-eligible' : ''}${extraClass ? ' ' + extraClass : ''}" style="color: ${style.textColor} !important; background: ${getReportBadgeBackground(style, playerId, reportsView === 'reports')} !important;"${attrs}>${escapeGithubTag(getReportBadgeText(style, playerId, false))}</span>`;
