                    pendingEgg.delete(id);
                    savePending();
                } catch (error) {
                    console.warn('[MOD Chat] Egg reaction:', error);
                    break;
                }
            }
        } finally { syncingEgg = false; }
    }
    function markRead() {
        if (unread.size) { unread.clear(); saveState(); }
        updateBadge();
    }
    function setOpen(next) {
        if (open === next) return;
        open = next;
        if (!panel || !panel.isConnected) { ensureUI(); return; }
        panel.classList.toggle('ss-modchat-active', open);
        const heading = panel.querySelector('#ss-reports-view-toggle');
        if (heading) {
            heading.textContent = open ? 'MOD Chat' : (getReportsView() === 'action' ? 'Action taken' : 'Reports');
            heading.classList.toggle('ss-action-view', !open && getReportsView() === 'action');
            heading.title = open ? 'Return to Reports' : 'Switch between Reports and Action taken';
        }
        const toggle = panel.querySelector('#ss-modchat-toggle');
        toggle?.setAttribute('aria-pressed', String(open));
        if (open) {
            markRead();
            render();
            fetchLatest(true);
            updateOlderButton();
            const list = panel.querySelector('#ss-modchat-messages');
            if (list) list.scrollTop = list.scrollHeight;
        } else {
            refreshReportsHeader?.();
        }
        updateBadge();
    }
    function ensureStyles() {
        if (document.getElementById('ss-modchat-styles')) return;
        const css = document.createElement('style');
        css.id = 'ss-modchat-styles';
        css.textContent = `
            #custom-reports-panel #ss-modchat-toggle {
                position:relative; display:inline-flex; align-items:center; justify-content:center;
                flex:0 0 auto; background:none !important; border:0 !important; padding:0 2px !important;
                margin:0; color:#ffffff !important; cursor:pointer; box-shadow:none !important;
                font-size:calc(19 * var(--ss-report-unit)) !important; line-height:1;
                text-shadow:none !important; opacity:1; transition:opacity .2s;
            }
            #custom-reports-panel #ss-modchat-toggle .fas { color:inherit !important; }
