        function updatePopupNameBadge(badge, playerId) {
            if (!badge) return false;
            const style = getReportNameStyle(playerId);
            const visible = !!(getGithubNameTag(playerId) && style);
            badge.textContent = visible ? getReportBadgeText(style, playerId, true) : '';
