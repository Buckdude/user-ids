        try {
            const response = await fetch(url + (url.includes('?') ? '&' : '?') + 'refresh=' + Date.now(), { cache: 'no-store' });
            if (!response.ok) return;
            const players = parseDirectoryJson(await response.text()).players;
            if (!players || typeof players !== 'object') return;
            let verified = verifiedDirectory;
            const verifiedURL = getRawLink(hub.GITHUB_VERIFIED_URL);
            if (verifiedURL) {
                try {
                    const result = await fetch(verifiedURL + '?refresh=' + Date.now(), { cache: 'no-store' });
                    if (result.ok) verified = parseDirectoryJson(await result.text()).players || {};
                } catch (_) {}
