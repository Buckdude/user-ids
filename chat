        if (Date.now() < nextDirectoryFetch) return;
        const hub = getHub();
        const url = getRawLink(hub.GITHUB_USER_TAGS_URL);
        const tagURL = getRawLink(hub.GITHUB_REPORT_TAGS_URL);
