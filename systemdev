        const REPORT_POPUP_LEGACY_TAG_IDS = {
            script_dev: 'script_dev', wizard: 'wizard', archwizard: 'archwizard',
            mod: 'mod', eggforcer: 'eggforcer', leaguemod: 'leaguemod', league: 'league',
            ccmod: 'ccmod', cc: 'creator', excc: 'excc', member: 'member',
            cheater: 'cheater', bot: 'bot', toxic: 'toxic'
        };

        function orderPopupReportTags(tagsElement, playerId) {
            if (!tagsElement) return;
            tagsElement.querySelectorAll(':scope > .ss-report-tag-row-break').forEach(element => element.remove());
            const order = getOrderedReportTagKeys(playerId);
            const children = Array.from(tagsElement.children);
            children.sort((a, b) => order.indexOf(a.dataset.ssTagKey) - order.indexOf(b.dataset.ssTagKey));
            children.forEach(element => tagsElement.appendChild(element));
            if (!['report_popup_user_tags', 'report_popup_reporter_tags'].includes(tagsElement.id)) return;
            const visibleTags = children.filter(element => element.style.display !== 'none');
            let remaining = visibleTags.length;
            let placed = 0;
            while (remaining > 3) {
                const rowSize = remaining === 4 ? 2 : 3;
                placed += rowSize;
                const breakElement = document.createElement('span');
                breakElement.className = 'ss-report-tag-row-break';
                breakElement.style.cssText = 'flex: 0 0 100%; height: 0; padding: 0; margin: 0; border: 0;';
                visibleTags[placed - 1].insertAdjacentElement('afterend', breakElement);
                remaining -= rowSize;
            }
        }

        function renderPopupRoleTags(container, name, playerId) {
            if (!container) return;
            const prefix = container.id === 'report_popup_user_tags' ? 'report_popup_' : 'report_popup_reporter_';
            const allowedKeys = new Set(reportTagDefinitions.filter(tag => !tag.isNameGroup).map(tag => tag.key));
            const existing = Array.from(container.querySelectorAll(':scope > .ss-report-tag'));
            const sizeReference = existing.find(tag => tag.dataset.ssTagKey && tag.style.fontSize) ||
                existing.find(tag => tag.style.fontSize) || null;
            const lockedMetrics = sizeReference ? [
                'font-size', 'line-height', 'padding-top', 'padding-right',
                'padding-bottom', 'padding-left', 'border-radius', 'margin-top', 'margin-bottom'
            ].map(property => [property, sizeReference.style.getPropertyValue(property), sizeReference.style.getPropertyPriority(property)]) : [];

            for (const element of existing) {
                if (element.dataset.ssTagKey && allowedKeys.has(element.dataset.ssTagKey)) continue;
                const legacyKey = Object.keys(REPORT_POPUP_LEGACY_TAG_IDS).find(key =>
                    element.id === `${prefix}${REPORT_POPUP_LEGACY_TAG_IDS[key]}_label`);
                if (!legacyKey || !allowedKeys.has(legacyKey)) element.remove();
            }

            for (const tag of reportTagDefinitions) {
                if (tag.isNameGroup) continue;
                const suffix = REPORT_POPUP_LEGACY_TAG_IDS[tag.key] || `custom_${tag.key}`;
                const id = `${prefix}${suffix}_label`;
                let element = container.querySelector(`#${id}`);
                if (!element) {
                    element = document.createElement('span');
                    element.id = id;
                    element.className = `ss-report-tag ss-report-tag-${tag.key}`;
                    for (const [property, value, priority] of lockedMetrics) {
                        if (value) element.style.setProperty(property, value, priority || 'important');
                    }
                    container.appendChild(element);
                }
                element.dataset.ssTagKey = tag.key;
                const isKnownCheater = tag.key === 'cheater' && getReportNameLabel(name, playerId) === 'KNOWN CHEATER';
                element.textContent = isKnownCheater && tag.popupName === 'CHEATER' ? 'KNOWN CHEATER' : getReportBadgeText(tag, playerId, true);
                configureReportBadge(element, tag, playerId);
                element.style.setProperty('color', tag.textColor, 'important');
                element.style.setProperty('background', getReportBadgeBackground(tag, playerId), 'important');
                if (tag.key === 'script_dev') element.style.setProperty('box-shadow', 'none', 'important');
                element.style.display = hasReportTag(tag.key, name, playerId) ? 'inline-block' : 'none';
            }
            orderPopupReportTags(container, playerId);
            container.style.display = Array.from(container.children).some(element =>
                element.classList.contains('ss-report-tag') && element.style.display !== 'none') ? 'flex' : 'none';
        }

        function escapeGithubTag(value) {
            return String(value).replace(/[&<>"']/g, character => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            })[character]);
        }

        function parseGithubUsersPayload(raw) {
            const source = String(raw ?? '');
            try {
                return { data: JSON.parse(source), recovered: false };
            } catch (parseError) {
                if (!/"players"\s*:\s*\{/.test(source)) throw parseError;
                const corrected = source.replace(/(\r?\n[ \t]*)\]([ \t]*\r?\n[ \t]*\}[ \t]*)$/, '$1}$2');
                if (corrected === source) throw parseError;
                const data = JSON.parse(corrected);
                if (!data || !data.players || typeof data.players !== 'object' || Array.isArray(data.players)) throw parseError;
                console.warn('[Reports] Corrected JSON bracket.');
                return { data, recovered: true };
            }
        }

        function loadGithubPlayerTags() {
            if (!githubLinkHub?.GITHUB_USER_TAGS_URL || (githubTagsLoading && githubTagsLoadingUrl === githubLinkHub.GITHUB_USER_TAGS_URL)) return;
            githubTagsLoading = true;
            const requestedTagUrl = githubLinkHub.GITHUB_USER_TAGS_URL;
            githubTagsLoadingUrl = requestedTagUrl;
            const url = `${requestedTagUrl}${requestedTagUrl.includes('?') ? '&' : '?'}refresh=${Date.now()}`;

            function acceptResponse(raw) {
                if (githubLinkHub?.GITHUB_USER_TAGS_URL !== requestedTagUrl) return;
                const { data } = parseGithubUsersPayload(raw);
                const changed = applyGithubPlayerTags(data);
                const cachedPlayers = {};
                for (const [id, entry] of githubPlayerTags) cachedPlayers[id] = entry;
                try { if (changed) GM_setValue(getGithubTagsCacheKey(), JSON.stringify({ players: cachedPlayers })); }
                catch (error) {}
                githubTagsLoading = false;
            }

            function tryBrowserFetch(reason) {
                if (githubLinkHub?.GITHUB_USER_TAGS_URL !== requestedTagUrl) return;
                if (typeof fetch !== 'function') {
                    failLoad(reason + '; browser fetch unavailable');
                    return;
                }
                fetch(url, { cache: 'no-store' })
                    .then(response => {
                        if (!response.ok) throw new Error(`HTTP ${response.status}`);
                        return response.text();
                    })
                    .then(raw => acceptResponse(raw))
                    .catch(error => failLoad(`${reason}; fallback: ${error.message || error}`));
            }

            function failLoad(reason) {
                if (githubLinkHub?.GITHUB_USER_TAGS_URL !== requestedTagUrl) return;
                githubTagsLoading = false;
                console.error('[Reports] Tags failed:', reason);
            }

            try {
                GM_xmlhttpRequest({
                    method: 'GET',
                    url,
                    timeout: 15000,
                    onload: response => {
                        if (response.status !== 200) {
                            tryBrowserFetch(`GM request HTTP ${response.status}`);
                            return;
                        }
                        try {
                            acceptResponse(String(response.responseText ?? response.response ?? ''));
                        } catch (error) {
                            tryBrowserFetch(`GM response error: ${error.message || error}`);
                        }
                    },
                    onerror: () => tryBrowserFetch('Tampermonkey request blocked or failed'),
                    ontimeout: () => tryBrowserFetch('Tampermonkey request timed out')
                });
            } catch (error) {
                tryBrowserFetch(`Tampermonkey request exception: ${error.message || error}`);
            }
        }

        function refreshOpenPopupGithubTags() {
            const popup = document.getElementById('reportInfoPopup');
            const report = window.currentSelectedReport;
            if (!popup || popup.style.display === 'none' || !report) return;
            const reporterMatch = report.reporter.match(/^(.*?)\s*\[(\d+)\]\s*$/);
            const reporterId = reporterMatch ? reporterMatch[2] : '';
            for (const [prefix, pid] of [
                ['report_popup_', report.pid],
                ['report_popup_reporter_', reporterId]
            ]) {
                const nameLabel = popup.querySelector(`#${prefix}name_label`);
                const tagsEl = popup.querySelector(`#${prefix === 'report_popup_' ? 'report_popup_user_tags' : 'report_popup_reporter_tags'}`);
                if (!nameLabel || !tagsEl) continue;
                const visibleName = updatePopupNameBadge(nameLabel, pid);
                const wrapId = prefix === 'report_popup_' ? 'report_popup_name_tag_wrap' : 'report_popup_reporter_name_tag_wrap';
                const nameTagWrap = popup.querySelector(`#${wrapId}`);
                if (nameTagWrap) nameTagWrap.style.display = visibleName ? 'flex' : 'none';

            }
            refreshOpenPopupModerationTags();
            keepReportPopupSize();
        }
        setInterval(loadGithubPlayerTags, GITHUB_PLAYER_REFRESH_MS);
        setInterval(loadGithubVerifiedNames, GITHUB_VERIFIED_REFRESH_MS);

        const HUB_REQUIRED_LINK_KEYS = [
            'GITHUB_USER_TAGS_URL', 'GITHUB_WHITELIST_URL',
            'GITHUB_CHEATER_IDS_URL', 'GITHUB_KNOWN_CHEATER_NAMES_URL',
            'GITHUB_BOTS_URL', 'GITHUB_TOXIC_URL', 'GITHUB_BWD_MEMBER_URL'
        ];
        function validatedGithubLinkHub(value) {
            if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('Invalid links JSON');
            for (const key of HUB_REQUIRED_LINK_KEYS) {
                if (!isGithubRawUrl(value[key])) throw new Error(`Invalid link: ${key}`);
            }
            if (value.GITHUB_VERIFIED_URL && !isGithubRawUrl(value.GITHUB_VERIFIED_URL))
                throw new Error('Invalid link: GITHUB_VERIFIED_URL');
            if (value.GITHUB_CHAT_URL && !isGithubRawUrl(value.GITHUB_CHAT_URL))
                throw new Error('Invalid link: GITHUB_CHAT_URL');
            return value;
        }
        function isGithubRawUrl(url) {
            if (typeof url !== 'string') return false;
            try {
                const parsed = new URL(url);
                return parsed.protocol === 'https:' && parsed.hostname === 'raw.githubusercontent.com';
            } catch (_) { return false; }
        }
        function readGithubHubText(url) {
            return new Promise((resolve, reject) => {
                const refreshed = `${url}${url.includes('?') ? '&' : '?'}refresh=${Date.now()}`;
                function browserFallback(reason) {
                    if (typeof fetch !== 'function') { reject(new Error(reason)); return; }
                    fetch(refreshed, { cache: 'no-store' }).then(response => {
                        if (!response.ok) throw new Error(`HTTP ${response.status}`);
                        return response.text();
                    }).then(resolve).catch(error => reject(new Error(`${reason}; ${error.message || error}`)));
                }
                try {
                    GM_xmlhttpRequest({
                        method: 'GET', url: refreshed, timeout: 12000,
                        onload: response => response.status === 200
                            ? resolve(String(response.responseText ?? response.response ?? ''))
                            : response.status === 404
                                ? reject(new Error('HTTP 404'))
                                : browserFallback(`HTTP ${response.status}`),
                        onerror: () => browserFallback('GitHub request failed'),
                        ontimeout: () => browserFallback('GitHub request timed out')
                    });
                } catch (error) { browserFallback(error.message || String(error)); }
            });
        }
        async function loadReportTagDefinitions() {
            if (reportTagDefinitionsLoading) return;
            reportTagDefinitionsLoading = true;
            try {
                const links = JSON.parse(await readGithubHubText(GITHUB_REPORT_TAGS_LINKS_URL));
                const tagsUrl = links?.GITHUB_REPORT_TAGS_URL;
                if (!isGithubRawUrl(tagsUrl)) throw new Error('Set GITHUB_REPORT_TAGS_URL in /admin');
                const raw = await readGithubHubText(tagsUrl);
                const definitions = parseReportTagDefinitions(raw);
                if (JSON.stringify(definitions) !== JSON.stringify(reportTagDefinitions)) {
                    reportTagDefinitions = definitions;
                    reportBadgeSwitches.clear();
                    restartReportBadgeFlashes();
                    renderReportsList(reportsArray);
                    refreshOpenPopupGithubTags();
                }
                try { GM_setValue(GITHUB_REPORT_TAGS_CACHE_KEY, raw); } catch (_) {}
            } catch (error) {
                console.warn('[Reports] GitHub /tags unavailable or invalid, keeping last valid tags:', error.message || error);
            } finally {
                reportTagDefinitionsLoading = false;
            }
        }

        try {
            const cachedDefinitions = GM_getValue(GITHUB_REPORT_TAGS_CACHE_KEY, '');
            if (cachedDefinitions) reportTagDefinitions = parseReportTagDefinitions(cachedDefinitions);
        } catch (error) {
            console.warn('[Reports] Cached /tags invalid, using original tags:', error);
        }
        restartReportBadgeFlashes();
        loadReportTagDefinitions();
        setInterval(loadReportTagDefinitions, REPORT_TAGS_REFRESH_MS);

        let modChatController = null;
        let modChatUrl = '';
        let modChatSource = '';
        let modChatLoading = false;

        async function loadModChatSystem() {
            const url = githubLinkHub?.GITHUB_CHAT_URL;
            if (!url || modChatLoading) return;
            modChatLoading = true;
            try {
                const source = await readGithubHubText(url);
                if (githubLinkHub?.GITHUB_CHAT_URL !== url) return;
                if (source === modChatSource && modChatController) return;
                if (modChatController) {
                    window.location.reload();
                    return;
                }
                const moduleFactory = new Function('window', 'document', 'globalThis',
                    `${source}\nreturn globalThis.__SS_MOD_CHAT_START__;`);
                const start = moduleFactory(window, document, globalThis);
                if (typeof start !== 'function') throw new Error('Invalid chat system entry.');
                delete globalThis.__SS_MOD_CHAT_START__;
                modChatController = start({
                    channelId: CHANNEL_ID,
                    requestAPI,
                    GM_getValue,
                    GM_setValue,
                    getReportsView: () => reportsView,
                    refreshReportsHeader: () => updateLogCounters(reportsArray)
                });
                modChatSource = source;
                modChatUrl = url;
            } catch (error) {
                console.warn('[Reports] MOD Chat unavailable:', error.message || error);
            } finally {
                modChatLoading = false;
            }
        }
        setInterval(loadModChatSystem, 30000);

        function useGithubLinkHub(links, force = false) {
            const tagUrlChanged = githubLinkHub?.GITHUB_USER_TAGS_URL !== links.GITHUB_USER_TAGS_URL;
            const verifiedUrlChanged = githubLinkHub?.GITHUB_VERIFIED_URL !== links.GITHUB_VERIFIED_URL;
            const moderationUrlChanged = HUB_REQUIRED_LINK_KEYS
                .filter(key => key !== 'GITHUB_USER_TAGS_URL')
