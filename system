globalThis.__SS_LIVE_REPORTS_START__ = function startShellReports(discordRequest) {
    'use strict';

    const CHANNEL_ID = "1126624154515406948";

    let lastUpdateTime = Date.now();
    window.currentSelectedReport = null;
    let successFadeTimeout = null;
    const reactionCache = {};
    const reactionConfirmed = {};
    const reactionPending = new Set();
    let reportsArray = [];
    let reportsView = 'reports';
    const QUICK_REACTION_EMOJIS = ['👍', '✅', '❌', '🚪', '❓'];
    const RESOLVED_REACTION_EMOJIS = ['👍', '✅', '❌'];
    const REPORT_SESSION_KEY = `ss-live-reports-${CHANNEL_ID}-temporary-state`;
    function loadTemporaryReportState() {
        try {
            const state = JSON.parse(sessionStorage.getItem(REPORT_SESSION_KEY) || '{}');
            return state && typeof state === 'object' ? state : {};
        } catch (e) {
            return {};
        }
    }
    const temporaryReportState = loadTemporaryReportState();
    const recentReportCounts = new Map(
        Object.entries(temporaryReportState.recentCounts || {}).filter(([, count]) =>
            /^\d+$/.test(String(count)))
    );
    function saveTemporaryReportState() {
        try {
            sessionStorage.setItem(REPORT_SESSION_KEY, JSON.stringify({
                recentCounts: Object.fromEntries(recentReportCounts)
            }));
        } catch (e) {
        }
    }
    function getOriginalRecentReportCount(messageId, count) {
        if (recentReportCounts.has(messageId)) return recentReportCounts.get(messageId);
        const originalCount = String(count);
        recentReportCounts.set(messageId, originalCount);
        saveTemporaryReportState();
        return originalCount;
    }

    const GITHUB_LINKS_URL = 'https://raw.githubusercontent.com/Buckdude/user-ids/refs/heads/main/links.';
    const GITHUB_LINKS_CACHE_KEY = 'ss-live-reports-links-hub';
    let GITHUB_USER_TAGS_URL = '';
    let GITHUB_WHITELIST_URL = '';
    let GITHUB_CHEATER_IDS_URL = '';
    let GITHUB_KNOWN_CHEATER_NAMES_URL = '';
    let GITHUB_BOTS_URL = '';
    let GITHUB_TOXIC_URL = '';
    let GITHUB_BWD_MEMBER_URL = '';
    let githubLinkHubLoading = false;

    const WHITELISTED_PLAYER_IDS = new Set();
    const KNOWN_CHEATER_NAMES = new Set();
    const KNOWN_CHEATER_PLAYER_IDS = new Set();
    const BOT_NAMES = new Set();
    const TOXIC_NAMES = new Set();
    const TOXIC_PLAYER_IDS = new Set();
    const GITHUB_BWD_MEMBER_IDS = new Set();

    function loadGitHubModerationTextList(url, targetSet, numericIds, listName) {
        if (!/^https:\/\//i.test(url)) return;
        const urlWithRefresh = `${url}${url.includes('?') ? '&' : '?'}refresh=${Date.now()}`;
        GM_xmlhttpRequest({
            method: 'GET',
            url: urlWithRefresh,
            timeout: 15000,
            onload: response => {
                if (response.status !== 200) {
                    console.warn(`[Reports] ${listName}: HTTP ${response.status}`);
                    return;
                }
                const next = new Set();
                for (const rawLine of String(response.responseText ?? '').split(/\r?\n/)) {
                    const line = rawLine.trim();
                    if (!line || line.startsWith('#')) continue;
                    if (numericIds && !/^\d+$/.test(line)) {
                        console.warn(`[Reports] Invalid ${listName} ID:`, line);
                        continue;
                    }
                    next.add(numericIds ? line : line.toLowerCase());
                }
                targetSet.clear();
                for (const entry of next) targetSet.add(entry);
                renderReportsList(reportsArray);
                refreshOpenPopupGithubTags();
            },
            onerror: () => console.warn(`[Reports] ${listName} failed`),
            ontimeout: () => console.warn(`[Reports] ${listName} timeout`)
        });
    }

    function refreshOpenPopupModerationTags() {
        const overlay = document.getElementById('reportPopupOverlay');
        const report = window.currentSelectedReport;
        if (!overlay || overlay.style.display === 'none' || !report) return;
        const reporterMatch = report.reporter.match(/^(.*?)\s*\[(\d+)\]\s*$/);
        const reporterName = reporterMatch ? reporterMatch[1].trim() : report.reporter;
        const reporterId = reporterMatch ? reporterMatch[2] : '';
        for (const [prefix, name, pid] of [
            ['report_popup_', report.name, report.pid],
            ['report_popup_reporter_', reporterName, reporterId]
        ]) {
            const label = overlay.querySelector(`#${prefix}cheater_label`);
            const toxicLabel = overlay.querySelector(`#${prefix}toxic_label`);
            const botLabel = overlay.querySelector(`#${prefix}bot_label`);
            const tagsEl = overlay.querySelector(`#${prefix === 'report_popup_' ? 'report_popup_user_tags' : 'report_popup_reporter_tags'}`);
            const nameLabel = getReportNameLabel(name, pid);
            const isCheater = nameLabel === 'KNOWN CHEATER' || nameLabel === 'CHEATER';
            if (label) {
                label.style.display = isCheater ? 'inline-block' : 'none';
                if (isCheater) label.textContent = nameLabel;
            }
            if (toxicLabel) toxicLabel.style.display = isToxicPlayer(name, pid) ? 'inline-block' : 'none';
            if (botLabel) botLabel.style.display = isBotPlayer(name) ? 'inline-block' : 'none';
            orderPopupReportTags(tagsEl, pid);
            if (tagsEl) tagsEl.style.display = Array.from(tagsEl.children).some(child => child.style.display !== 'none') ? 'flex' : 'none';
        }
    }

    function loadGitHubToxicList() {
        if (!/^https:\/\//i.test(GITHUB_TOXIC_URL)) return;
        const urlWithRefresh = `${GITHUB_TOXIC_URL}${GITHUB_TOXIC_URL.includes('?') ? '&' : '?'}refresh=${Date.now()}`;
        GM_xmlhttpRequest({
            method: 'GET',
            url: urlWithRefresh,
            timeout: 15000,
            onload: response => {
                if (response.status !== 200) {
                    console.warn(`[Reports] toxic: HTTP ${response.status}`);
                    return;
                }
                const nextNames = new Set();
                const nextIds = new Set();
                let section = null;
                for (const rawLine of String(response.responseText ?? '').split(/\r?\n/)) {
                    const entry = rawLine.trim();
                    if (!entry || entry.startsWith('#')) continue;
                    if (/^\[ids\]$/i.test(entry)) {
                        section = 'ids';
                        continue;
                    }
                    if (/^\[usernames\]$/i.test(entry)) {
                        section = 'usernames';
                        continue;
                    }
                    if (/^\[[^\]]+\]$/.test(entry)) {
                        console.warn('[Reports] Invalid toxic section:', entry);
                        section = 'unknown';
                        continue;
                    }
                    if (section === 'unknown') continue;
                    if (section === 'usernames') {
                        nextNames.add(entry.toLowerCase());
                    } else if (section === 'ids') {
                        if (/^\d+$/.test(entry)) nextIds.add(entry);
                        else console.warn('[Reports] Invalid toxic ID:', entry);
                    } else {
                        if (/^\d+$/.test(entry)) nextIds.add(entry);
                        else nextNames.add(entry.toLowerCase());
                    }
                }
                TOXIC_NAMES.clear();
                TOXIC_PLAYER_IDS.clear();
                for (const name of nextNames) TOXIC_NAMES.add(name);
                for (const id of nextIds) TOXIC_PLAYER_IDS.add(id);
                renderReportsList(reportsArray);
                refreshOpenPopupModerationTags();
            },
            onerror: () => console.warn('[Reports] toxic failed'),
            ontimeout: () => console.warn('[Reports] toxic timeout')
        });
    }

    function loadGitHubModerationLists() {
        loadGitHubModerationTextList(GITHUB_WHITELIST_URL, WHITELISTED_PLAYER_IDS, true, 'whitelist');
        loadGitHubModerationTextList(GITHUB_CHEATER_IDS_URL, KNOWN_CHEATER_PLAYER_IDS, true, 'cheater IDs');
        loadGitHubModerationTextList(GITHUB_KNOWN_CHEATER_NAMES_URL, KNOWN_CHEATER_NAMES, false, 'known cheater names');
        loadGitHubModerationTextList(GITHUB_BOTS_URL, BOT_NAMES, false, 'bot names');
        loadGitHubModerationTextList(GITHUB_BWD_MEMBER_URL, GITHUB_BWD_MEMBER_IDS, true, 'BWD member IDs');
        loadGitHubToxicList();
    }

    let githubPlayerTags = new Map();
    let lastGithubTagUpdate = 0;
    let githubTagsLoading = false;
    let githubTagsLoadingUrl = '';
    const getGithubTagsCacheKey = () => 'ss-live-reports-tag-data:' + encodeURIComponent(GITHUB_USER_TAGS_URL);
    let githubNameTagsEnabled = false;

    function getGithubPlayer(playerId) {
        return githubPlayerTags.get(String(playerId ?? '').trim()) || null;
    }

    function applyGithubPlayerTags(data) {
        if (!data || !data.players || typeof data.players !== 'object' || Array.isArray(data.players)) {
            throw new Error('Expected a JSON object with a "players" field');
        }
        const next = new Map();
        for (const [pid, entry] of Object.entries(data.players)) {
            if (!/^\d+$/.test(pid) || !entry || typeof entry !== 'object' || Array.isArray(entry)) continue;
            const name = typeof entry.name === 'string' ? entry.name.trim() : '';
            const nickname = typeof entry.nickname === 'string' ? entry.nickname.trim() : '';
            const tags = Array.isArray(entry.tags)
                ? entry.tags.filter(tag => typeof tag === 'string').map(tag => tag.trim().toLowerCase()).filter(Boolean)
                : [];
            if (!name && !nickname && tags.length === 0) continue;
            next.set(pid, { name, nickname, tags });
        }
        githubNameTagsEnabled = Array.from(next.values()).some(entry => !!(entry.name || entry.nickname));
        githubPlayerTags = next;
        lastGithubTagUpdate = Date.now();
        renderReportsList(reportsArray);
        refreshOpenPopupGithubTags();
    }

    function restoreGithubTagsForCurrentUrl() {
        if (!GITHUB_USER_TAGS_URL) return;
        try {
            const stored = GM_getValue(getGithubTagsCacheKey(), '');
            if (stored) applyGithubPlayerTags(JSON.parse(stored));
        } catch (error) {
            console.warn('[Reports] Tag cache invalid:', error);
        }
    }

    function getGithubNameTag(playerId) {
        if (!githubNameTagsEnabled) return '';
        const entry = getGithubPlayer(playerId);
        return entry ? (entry.nickname || entry.name || '') : '';
    }

    function hasGithubRole(playerId, role) {
        const entry = getGithubPlayer(playerId);
        if (!entry) return false;
        if (role === 'cc') return entry.tags.includes('cc') || entry.tags.includes('creator') || entry.tags.includes('content creator');
        if (role === 'member') return entry.tags.includes('member') || entry.tags.includes('bwd member');
        return entry.tags.includes(role);
    }

    function isWizardPlayer(playerId) {
        return hasGithubRole(playerId, 'wizard') ||
            hasGithubRole(playerId, 'developer') ||
            hasGithubRole(playerId, 'dev');
    }

    function getOrderedReportTagKeys(playerId) {
        const order = [];
        const knownKeys = new Set(['wizard', 'eggforcer', 'cc', 'member', 'cheater', 'toxic', 'bot']);
        const aliases = {
            'creator': 'cc', 'content creator': 'cc',
            'bwd member': 'member', 'bwd_member': 'member',
            'developer': 'wizard', 'dev': 'wizard'
        };
        function add(tag) {
            const normalized = String(tag ?? '').trim().toLowerCase();
            const key = aliases[normalized] || normalized;
            if (knownKeys.has(key) && !order.includes(key)) order.push(key);
        }
        const entry = getGithubPlayer(playerId);
        if (entry && Array.isArray(entry.tags)) entry.tags.forEach(add);
        ['cheater', 'bot', 'toxic', 'wizard', 'eggforcer', 'cc', 'member'].forEach(add);
        order.splice(order.indexOf('toxic'), 1);
        order.unshift('toxic');
        return order;
    }

    function orderPopupReportTags(tagsElement, playerId) {
        if (!tagsElement) return;
        const order = getOrderedReportTagKeys(playerId);
        const suffixToKey = {
            eggforcer_label: 'eggforcer',
            creator_label: 'cc', member_label: 'member', wizard_label: 'wizard',
            cheater_label: 'cheater', toxic_label: 'toxic', bot_label: 'bot'
        };
        const children = Array.from(tagsElement.children);
        const keyOf = element => {
            const suffix = Object.keys(suffixToKey).find(s => element.id.endsWith(s));
            return suffix ? suffixToKey[suffix] : '';
        };
        children.sort((a, b) => order.indexOf(keyOf(a)) - order.indexOf(keyOf(b)));
        children.forEach(element => tagsElement.appendChild(element));
    }

    function escapeGithubTag(value) {
        return String(value).replace(/[&<>"']/g, character => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
        })[character]);
    }

    function parseGithubUsersPayload(raw) {
        const source = String(raw ?? '');
        try {
            return { data: JSON.parse(source), recovered: false };
        } catch (parseError) {
            if (!/"players"\s*:\s*\{/.test(source)) throw parseError;
            const corrected = source.replace(/(\r?\n[ \t]*)\]([ \t]*\r?\n[ \t]*\}[ \t]*)$/, '$1}$2');
            if (corrected === source) throw parseError;
            const data = JSON.parse(corrected);
            if (!data || !data.players || typeof data.players !== 'object' || Array.isArray(data.players)) throw parseError;
            console.warn('[Reports] Corrected JSON bracket.');
            return { data, recovered: true };
        }
    }

    function loadGithubPlayerTags() {
        if (!GITHUB_USER_TAGS_URL || (githubTagsLoading && githubTagsLoadingUrl === GITHUB_USER_TAGS_URL)) return;
        githubTagsLoading = true;
        const requestedTagUrl = GITHUB_USER_TAGS_URL;
        githubTagsLoadingUrl = requestedTagUrl;
        const url = `${requestedTagUrl}${requestedTagUrl.includes('?') ? '&' : '?'}refresh=${Date.now()}`;

        function acceptResponse(raw) {
            if (GITHUB_USER_TAGS_URL !== requestedTagUrl) return;
            const { data } = parseGithubUsersPayload(raw);
            applyGithubPlayerTags(data);
            const cachedPlayers = {};
            for (const [id, entry] of githubPlayerTags) cachedPlayers[id] = entry;
            try { GM_setValue(getGithubTagsCacheKey(), JSON.stringify({ players: cachedPlayers })); }
            catch (error) {}
            githubTagsLoading = false;
        }

        function tryBrowserFetch(reason) {
            if (GITHUB_USER_TAGS_URL !== requestedTagUrl) return;
            if (typeof fetch !== 'function') {
                failLoad(reason + '; browser fetch unavailable');
                return;
            }
            fetch(url, { cache: 'no-store' })
                .then(response => {
                    if (!response.ok) throw new Error(`HTTP ${response.status}`);
                    return response.text();
                })
                .then(raw => acceptResponse(raw))
                .catch(error => failLoad(`${reason}; fallback: ${error.message || error}`));
        }

        function failLoad(reason) {
            if (GITHUB_USER_TAGS_URL !== requestedTagUrl) return;
            githubTagsLoading = false;
            console.error('[Reports] Tags failed:', reason);
        }

        try {
            GM_xmlhttpRequest({
                method: 'GET',
                url,
                timeout: 15000,
                onload: response => {
                    if (response.status !== 200) {
                        tryBrowserFetch(`GM request HTTP ${response.status}`);
                        return;
                    }
                    try {
                        acceptResponse(String(response.responseText ?? response.response ?? ''));
                    } catch (error) {
                        tryBrowserFetch(`GM response error: ${error.message || error}`);
                    }
                },
                onerror: () => tryBrowserFetch('Tampermonkey request blocked or failed'),
                ontimeout: () => tryBrowserFetch('Tampermonkey request timed out')
            });
        } catch (error) {
            tryBrowserFetch(`Tampermonkey request exception: ${error.message || error}`);
        }
    }

    function refreshOpenPopupGithubTags() {
        const overlay = document.getElementById('reportPopupOverlay');
        const report = window.currentSelectedReport;
        if (!overlay || overlay.style.display === 'none' || !report) return;
        const reporterMatch = report.reporter.match(/^(.*?)\s*\[(\d+)\]\s*$/);
        const reporterId = reporterMatch ? reporterMatch[2] : '';
        for (const [prefix, pid] of [
            ['report_popup_', report.pid],
            ['report_popup_reporter_', reporterId]
        ]) {
            const nameLabel = overlay.querySelector(`#${prefix}name_label`);
            const tagsEl = overlay.querySelector(`#${prefix === 'report_popup_' ? 'report_popup_user_tags' : 'report_popup_reporter_tags'}`);
            if (!nameLabel || !tagsEl) continue;
            const displayName = getGithubNameTag(pid);
            nameLabel.textContent = displayName;
            nameLabel.style.display = displayName ? 'inline-block' : 'none';
            if (prefix === 'report_popup_' || prefix === 'report_popup_reporter_') {
                const wrapId = prefix === 'report_popup_' ? 'report_popup_name_tag_wrap' : 'report_popup_reporter_name_tag_wrap';
                const nameTagWrap = overlay.querySelector(`#${wrapId}`);
                if (nameTagWrap) nameTagWrap.style.display = displayName ? 'flex' : 'none';
            }
            const roles = {
                creator_label: hasGithubRole(pid, 'cc'),
                member_label: isBwdMemberPlayer(pid),
                eggforcer_label: hasGithubRole(pid, 'eggforcer'),
                wizard_label: isWizardPlayer(pid)
            };
            for (const [suffix, enabled] of Object.entries(roles)) {
                const label = overlay.querySelector(`#${prefix}${suffix}`);
                if (label) label.style.display = enabled ? 'inline-block' : 'none';
            }
            orderPopupReportTags(tagsEl, pid);
            tagsEl.style.display = Array.from(tagsEl.children).some(child => child.style.display !== 'none') ? 'flex' : 'none';
        }
        refreshOpenPopupModerationTags();
    }
    const HUB_REQUIRED_LINK_KEYS = [
        'GITHUB_USER_TAGS_URL', 'GITHUB_WHITELIST_URL',
        'GITHUB_CHEATER_IDS_URL', 'GITHUB_KNOWN_CHEATER_NAMES_URL',
        'GITHUB_BOTS_URL', 'GITHUB_TOXIC_URL', 'GITHUB_BWD_MEMBER_URL'
    ];
    function validatedGithubLinkHub(value) {
        if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('links. must be a JSON object');
        for (const key of HUB_REQUIRED_LINK_KEYS) {
            if (!isGithubRawUrl(value[key])) throw new Error(`links. missing or invalid ${key}`);
        }
        if (!isGithubRawUrl(value.GITHUB_STAFF_URL)) throw new Error('links. missing or invalid GITHUB_STAFF_URL');
        if (value.GITHUB_PRIVATE_TAGS_URL && !isGithubRawUrl(value.GITHUB_PRIVATE_TAGS_URL)) {
            throw new Error('links. has invalid GITHUB_PRIVATE_TAGS_URL');
        }
        return value;
    }
    function isGithubRawUrl(url) {
        if (typeof url !== 'string') return false;
        try {
            const parsed = new URL(url);
            return parsed.protocol === 'https:' && parsed.hostname === 'raw.githubusercontent.com';
        } catch (_) { return false; }
    }
    function readGithubHubText(url) {
        return new Promise((resolve, reject) => {
            const refreshed = `${url}${url.includes('?') ? '&' : '?'}refresh=${Date.now()}`;
            function browserFallback(reason) {
                if (typeof fetch !== 'function') { reject(new Error(reason)); return; }
                fetch(refreshed, { cache: 'no-store' }).then(response => {
                    if (!response.ok) throw new Error(`HTTP ${response.status}`);
                    return response.text();
                }).then(resolve).catch(error => reject(new Error(`${reason}; ${error.message || error}`)));
            }
            try {
                GM_xmlhttpRequest({
                    method: 'GET', url: refreshed, timeout: 15000,
                    onload: response => response.status === 200
                        ? resolve(String(response.responseText ?? response.response ?? ''))
                        : browserFallback(`HTTP ${response.status}`),
                    onerror: () => browserFallback('GitHub request failed'),
                    ontimeout: () => browserFallback('GitHub request timed out')
                });
            } catch (error) { browserFallback(error.message || String(error)); }
        });
    }
    function useGithubLinkHub(links, privateMode) {
        const userTagUrl = privateMode && links.GITHUB_PRIVATE_TAGS_URL
            ? links.GITHUB_PRIVATE_TAGS_URL : links.GITHUB_USER_TAGS_URL;
        const urlChanged = GITHUB_USER_TAGS_URL !== userTagUrl;
        GITHUB_USER_TAGS_URL = userTagUrl;
        GITHUB_WHITELIST_URL = links.GITHUB_WHITELIST_URL;
        GITHUB_CHEATER_IDS_URL = links.GITHUB_CHEATER_IDS_URL;
        GITHUB_KNOWN_CHEATER_NAMES_URL = links.GITHUB_KNOWN_CHEATER_NAMES_URL;
        GITHUB_BOTS_URL = links.GITHUB_BOTS_URL;
        GITHUB_TOXIC_URL = links.GITHUB_TOXIC_URL;
        GITHUB_BWD_MEMBER_URL = links.GITHUB_BWD_MEMBER_URL;
        if (urlChanged) {
            githubTagsLoading = false;
            githubPlayerTags = new Map();
            githubNameTagsEnabled = false;
            lastGithubTagUpdate = 0;
            restoreGithubTagsForCurrentUrl();
            renderReportsList(reportsArray);
            refreshOpenPopupGithubTags();
        }
        loadGitHubModerationLists();
        loadGithubPlayerTags();
    }
    async function loadGithubLinkHub() {
        if (githubLinkHubLoading) return;
        githubLinkHubLoading = true;
        let links;
        try {
            links = validatedGithubLinkHub(JSON.parse(await readGithubHubText(GITHUB_LINKS_URL)));
            try { GM_setValue(GITHUB_LINKS_CACHE_KEY, JSON.stringify(links)); } catch (_) {}
        } catch (error) {
            console.warn('[Reports] links. failed:', error);
            try {
                const cached = GM_getValue(GITHUB_LINKS_CACHE_KEY, '');
                if (cached) links = validatedGithubLinkHub(JSON.parse(cached));
            } catch (cacheError) {
                console.warn('[Reports] links. cache invalid:', cacheError);
            }
        }
        try {
            if (!links) {
                console.error('[Reports] links. missing.');
                return;
            }
            let privateMode = false;
            try {
                const staffText = await readGithubHubText(links.GITHUB_STAFF_URL);
                privateMode = staffText.trim().toLowerCase() === 'private';
            } catch (error) {
                console.warn('[Reports] staff unavailable:', error);
            }
            if (privateMode && !links.GITHUB_PRIVATE_TAGS_URL) {
                console.warn('[Reports] Private tags URL missing.');
            }
            useGithubLinkHub(links, privateMode);
        } finally {
            githubLinkHubLoading = false;
        }
    }
    loadGithubLinkHub();
    setInterval(loadGithubLinkHub, 120000);

    const normalizeReportName = name => String(name ?? '').trim().toLowerCase();
    const normalizeBotName = name => normalizeReportName(name)
        .replace(/[86]/g, 'b').replace(/0/g, 'o')
        .replace(/[7+]/g, 't').replace(/3/g, 'e')
        .replace(/[4@]/g, 'a').replace(/2/g, 'z')
        .replace(/[<(]/g, 'c').replace(/[1!|]/g, 'l')
        .replace(/[5$]/g, 's').replace(/[^a-z]/g, '');

    function botNameDistance(a, b) {
        const d = Array.from({ length: a.length + 1 }, () => Array(b.length + 1).fill(0));
        for (let i = 0; i <= a.length; i++) d[i][0] = i;
        for (let j = 0; j <= b.length; j++) d[0][j] = j;
        for (let i = 1; i <= a.length; i++) {
            for (let j = 1; j <= b.length; j++) {
                d[i][j] = Math.min(
                    d[i - 1][j] + 1,
                    d[i][j - 1] + 1,
                    d[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1)
                );
                if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1]) {
                    d[i][j] = Math.min(d[i][j], d[i - 2][j - 2] + 1);
                }
            }
        }
        return d[a.length][b.length];
    }

    function isBotPlayer(name) {
        const normalized = normalizeBotName(name);
        return normalized.length >= 6 && Array.from(BOT_NAMES).some(bot => {
            const target = normalizeBotName(bot);
            return target.length >= 6 && botNameDistance(normalized, target) <= Math.ceil(target.length * 0.25);
        });
    }

    function getReportNameLabel(name, playerId) {
        if (KNOWN_CHEATER_NAMES.has(normalizeReportName(name))) return 'KNOWN CHEATER';
        if (KNOWN_CHEATER_PLAYER_IDS.has(String(playerId))) return 'CHEATER';
        return isBotPlayer(name) ? 'Bot' : null;
    }

    function isToxicPlayer(name, playerId) {
        return TOXIC_NAMES.has(normalizeReportName(name)) ||
            TOXIC_PLAYER_IDS.has(String(playerId)) ||
            hasGithubRole(playerId, 'toxic');
    }

    function isBwdMemberPlayer(playerId) {
        return GITHUB_BWD_MEMBER_IDS.has(String(playerId)) || hasGithubRole(playerId, 'member');
    }

    function getActionTakenReactionIndicators(report) {
        const indicators = [];
        const seenQuickEmojis = new Set();
        (report.reactions || []).forEach(reaction => {
            if (!reaction.emoji) return;
            const otherReacted = reaction.count > (reaction.me ? 1 : 0);
            if (otherReacted) indicators.push({ ...reaction, mine: false });

            const discordEmoji = reaction.emojiId ? `${reaction.emoji}:${reaction.emojiId}` : reaction.emoji;
            const cacheKey = `${report.id}-${encodeURIComponent(discordEmoji)}`;
            const mine = (cacheKey in reactionCache) ? !!reactionCache[cacheKey] : !!reaction.me;
            if (mine) indicators.push({ ...reaction, mine: true });
            if (!reaction.emojiId && QUICK_REACTION_EMOJIS.includes(reaction.emoji)) {
                seenQuickEmojis.add(reaction.emoji);
            }
        });
        QUICK_REACTION_EMOJIS.forEach(emoji => {
            if (seenQuickEmojis.has(emoji)) return;
            if (reactionCache[`${report.id}-${encodeURIComponent(emoji)}`]) {
                indicators.push({ emoji, mine: true });
            }
        });
        return indicators;
    }

    function isActionTaken(report) {
        const reactions = report.reactions || [];
        const someoneElseReacted = reactions.some(reaction => reaction.count > (reaction.me ? 1 : 0));
        const myOtherReaction = reactions.some(reaction => reaction.me && !QUICK_REACTION_EMOJIS.includes(reaction.emoji));
        const myQuickReaction = QUICK_REACTION_EMOJIS.some(emoji => {
            const key = `${report.id}-${encodeURIComponent(emoji)}`;
            return (key in reactionCache) ? !!reactionCache[key] : reactions.some(r => r.emoji === emoji && r.me);
        });
        return someoneElseReacted || myOtherReaction || myQuickReaction;
    }

    function hasResolvingReaction(report) {
        return RESOLVED_REACTION_EMOJIS.some(emoji => {
            const key = `${report.id}-${encodeURIComponent(emoji)}`;
            const reaction = (report.reactions || []).find(item => item.emoji === emoji);
            const fromAnotherMod = !!reaction && reaction.count > (reaction.me ? 1 : 0);
            const fromMe = (key in reactionCache) ? !!reactionCache[key] : !!reaction?.me;
            return fromAnotherMod || fromMe;
        });
    }

    function isEarlierOrSameReport(report, actedReport) {
        const count = Number(report.recentReports);
        const actedCount = Number(actedReport.recentReports);
        if (Number.isFinite(count) && count > 0 &&
            Number.isFinite(actedCount) && actedCount > 0 && count !== actedCount) {
            return count < actedCount;
        }
        if (Number.isFinite(report.createdAt) && Number.isFinite(actedReport.createdAt)) {
            if (report.createdAt !== actedReport.createdAt) return report.createdAt < actedReport.createdAt;
        }
        try {
            return BigInt(report.id) <= BigInt(actedReport.id);
        } catch (e) {
            return report.id === actedReport.id;
        }
    }

    function getVisibleReports(reports, view) {
        if (view === 'action') return reports.filter(isActionTaken);

        const resolvedByPlayer = new Map();
        for (const report of reports) {
            if (!hasResolvingReaction(report)) continue;
            if (!resolvedByPlayer.has(report.pid)) resolvedByPlayer.set(report.pid, []);
            resolvedByPlayer.get(report.pid).push(report);
        }
        return reports.filter(report => {
            if (isActionTaken(report)) return false;
            const resolvingReports = resolvedByPlayer.get(report.pid) || [];
            return !resolvingReports.some(actedReport => isEarlierOrSameReport(report, actedReport));
        });
    }

    function requestAPI(method, url) {
        return discordRequest(method, url);
    }


    async function fetchDiscordReports() {
        const url = `https://discord.com/api/v9/channels/${CHANNEL_ID}/messages?limit=15`;
        const placeholder = document.getElementById('ss-reports-placeholder');

        try {
            const res = await requestAPI("GET", url);

            if (res.status !== 200) {
                if (placeholder) {
                    if (res.status === 401) placeholder.innerText = "Error 401: Invalid Token.";
                    else if (res.status === 403) placeholder.innerText = "Error 403: No access.";
                    else placeholder.innerText = `Error: ${res.status}`;
                    placeholder.style.color = "#cc0000";
                }
                return;
            }

            const messages = JSON.parse(res.responseText);
            let parsedReports = [];

            for (let msg of messages) {
                (msg.reactions || []).forEach(reaction => {
                    if (!reaction.emoji || !reaction.emoji.name) return;
                    const emoji = reaction.emoji.id ? `${reaction.emoji.name}:${reaction.emoji.id}` : reaction.emoji.name;
                    const key = `${msg.id}-${encodeURIComponent(emoji)}`;
                    if (!(key in reactionCache)) reactionCache[key] = !!reaction.me;
                    if (!(key in reactionConfirmed)) reactionConfirmed[key] = !!reaction.me;
                });
                let fullText = msg.content + "\n";
                if (msg.embeds && msg.embeds.length > 0) {
                    msg.embeds.forEach(embed => {
                        fullText += (embed.title || "") + "\n" + (embed.description || "") + "\n" + (embed.url || "") + "\n";
                    });
                }
                if (msg.components) fullText += JSON.stringify(msg.components) + "\n";

                const rrMatch = fullText.match(/(\d+)\s+recent reports/i);
                const recentReportsCount = getOriginalRecentReportCount(msg.id, rrMatch ? rrMatch[1] : "0");

                const lines = fullText.split(/\n|\\n/);
                for (let line of lines) {
                    let cleanLine = line.replace(/[*_~`]/g, '').trim();
                    const match = cleanLine.match(/(.+?)\s*\[(\d+)\]\s*reported by:\s*(.+?\[\d+\])\s*for:\s*(.+?)(?:\s*-\s*(.*))?$/i);

                    if (match) {
                        const name = match[1].trim();
                        const pid = match[2];
                        if (WHITELISTED_PLAYER_IDS.has(pid) || hasGithubRole(pid, 'eggforcer')) continue;
                        const reporter = match[3].trim();
                        const reason = match[4].trim();
                        const remainder = (match[5] || "").trim();

                        let serverCode = "Unknown";
                        let obsUrl = "";

                        const urlRegex = /(https?:\/\/shellshock\.io[^\s\>\]\)"']+)/i;
                        const urlMatch = remainder.match(urlRegex) || line.match(urlRegex) || fullText.match(urlRegex);
                        if (urlMatch) obsUrl = urlMatch[1];

                        if (obsUrl && obsUrl.includes('#')) {
                            serverCode = obsUrl.split('#').pop();
                        }
                        if (serverCode === "Unknown" && remainder.includes('[')) {
                            const mdMatch = remainder.match(/\[([^\]]+)\]/);
                            if (mdMatch) serverCode = mdMatch[1];
                        }
                        if (serverCode === "Unknown") {
                            const patternMatch = cleanLine.match(/([a-z]+-[a-z]+-[a-z]+)/i);
                            if (patternMatch) serverCode = patternMatch[1];
                        }

                        serverCode = serverCode.replace(/[\>\]\)]/g, '').trim();
                        if (!serverCode) serverCode = "Unknown";

                        const dateObj = new Date(msg.timestamp);
                        const timeFormatted = dateObj.toLocaleString('en-US', {
                            month: 'long', day: 'numeric', year: 'numeric',
                            hour: 'numeric', minute: '2-digit', hour12: true
                        }).replace(' at ', ' at ');

                        parsedReports.push({
                            id: msg.id, name: name, pid: pid, reporter: reporter,
                            reason: reason, server: serverCode, link: obsUrl,
                            time: timeFormatted, createdAt: dateObj.getTime(), recentReports: recentReportsCount,
                            reactions: (msg.reactions || []).map(reaction => ({
                                emoji: reaction.emoji ? reaction.emoji.name : '',
                                emojiId: reaction.emoji?.id || null,
                                animated: !!reaction.emoji?.animated,
                                count: Number(reaction.count) || 0,
                                me: !!reaction.me
                            }))
                        });
                    }
                }
                if (parsedReports.length >= 15) break;
            }

            const activeIds = new Set(parsedReports.map(report => report.id));
            let countStateChanged = false;
            for (const messageId of recentReportCounts.keys()) {
                if (!activeIds.has(messageId)) {
                    recentReportCounts.delete(messageId);
                    countStateChanged = true;
                }
            }
            if (countStateChanged) saveTemporaryReportState();

            if (parsedReports.length === 0) {
                if (reportsArray.length > 0) {
                    reportsArray = [];
                    lastUpdateTime = Date.now();
                    renderReportsList(reportsArray);
                    updateTimeText();
                } else if (placeholder) {
                    placeholder.innerHTML = `No valid reports found.`;
                    placeholder.style.color = "#0c576f";
                }
                return;
            }

            if (JSON.stringify(parsedReports) !== JSON.stringify(reportsArray)) {
                reportsArray = parsedReports;
                lastUpdateTime = Date.now();
                renderReportsList(reportsArray);
                updateTimeText();
            }

            if (window.currentSelectedReport) {
                const latestSelected = parsedReports.find(report => report.id === window.currentSelectedReport.id);
                if (latestSelected) {
                    window.currentSelectedReport = latestSelected;
                    updateQuickReactionButtons(latestSelected.id);
                }
            }
        } catch (e) {
            if (placeholder) {
                placeholder.innerText = "Network Error.";
                placeholder.style.color = "#cc0000";
            }
        }
    }

