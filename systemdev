            const counterZoom = getReportPopupVisualZoom();
            const visualScale = REPORT_POPUP_UI_SCALE * counterZoom;
            const body = popup.querySelector('.ss-report-popup-body');
            if (body) {
                body.style.width = reportPopupReasonCount >= 4 ? '100%' : '';
