        function hasReportTag(key, name, playerId) {
            if (key === 'script_dev') return isScriptDevPlayer(playerId);
            if (key === 'member') return isBwdMemberPlayer(playerId);
            if (key === 'cheater') return ['CHEATER', 'KNOWN CHEATER'].includes(getReportNameLabel(name, playerId)) || hasGithubRole(playerId, key);
            if (key === 'bot') return isBotPlayer(name) || hasGithubRole(playerId, key);
            if (key === 'toxic') return isToxicPlayer(name, playerId);
