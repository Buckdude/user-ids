                            indicator.addEventListener('click', removeOwnReaction);
                            indicator.addEventListener('keydown', event => {
                                if (event.key === 'Enter' || event.key === ' ') {
                                    event.preventDefault();
                                    removeOwnReaction(event);
                                }
                            });
                        }
                    });
                }

                const textWrap = reportRow.querySelector('.player-challenge-single-content');
                textWrap.addEventListener('click', () => {
                    injectPopup();
                    const overlay = document.getElementById('reportPopupOverlay');
                    const popup = document.getElementById('reportInfoPopup');
                    if (!overlay || !popup) return;
                    const title = popup.querySelector('#report_popup_title');
                    const recentEl = popup.querySelector('#report_popup_recent');
                    const time = popup.querySelector('#report_popup_time');
                    const serverCode = popup.querySelector('#report_popup_server');
                    const playerId = popup.querySelector('#report_popup_pid_value');
                    const reporterName = popup.querySelector('#report_popup_reporter_name');
                    const reporterId = popup.querySelector('#report_popup_reporter_id');
                    const reporterIdLine = popup.querySelector('#report_popup_reporter_id_line');
                    const reason = popup.querySelector('#report_popup_reason');
                    const reactionStatus = popup.querySelector('#report_popup_success');
                    if (!title || !recentEl || !time || !serverCode || !playerId ||
                        !reporterName || !reporterId || !reporterIdLine || !reason) return;

                    window.currentSelectedReport = report;
                    title.innerText = originalReportName;
                    const nameLabelEl = popup.querySelector('#report_popup_name_label');
                    const nameTagWrap = popup.querySelector('#report_popup_name_tag_wrap');
                    const nameVisible = updatePopupNameBadge(nameLabelEl, report.pid);
                    if (nameTagWrap) nameTagWrap.style.display = nameVisible ? 'flex' : 'none';

                    const recentCount = Number(report.recentReports) || 0;
                    recentEl.style.display = recentCount > 0 ? '' : 'none';
                    if (recentCount > 0) {
                        recentEl.innerText = `${recentCount} RECENT REPORT${recentCount === 1 ? '' : 'S'}`;
                        recentEl.style.color = '#fff';
                        recentEl.style.backgroundColor = recentCount >= 10 ? '#000000' : recentCount >= 5 ? '#900100' : recentCount >= 3 ? '#cc0000' : recentCount === 2 ? '#f79520' : '#ffe600';
                        const referenceTag = popup.querySelector('#report_popup_reporter_member_label') || popup.querySelector('#report_popup_reporter_tags .ss-report-tag');
                        const referenceStyle = referenceTag ? getComputedStyle(referenceTag) : null;
                        recentEl.style.fontWeight = referenceStyle?.fontWeight || '900';
                        recentEl.style.fontSize = referenceStyle?.fontSize || '0.7em';
                        recentEl.style.lineHeight = referenceStyle?.lineHeight || '1.2';
                        recentEl.style.padding = referenceStyle?.padding || '2px 8px';
                    }
                    serverCode.textContent = report.server === "Unknown" ? "Unknown" : `#${String(report.server).replace(/^#/, "")}`;
                    time.innerText = report.time;
                    playerId.textContent = report.pid;
                    const reporterMatch = report.reporter.match(/^(.*?)\s*\[(\d+)\]\s*$/);
                    const reporterPlayerName = reporterMatch ? reporterMatch[1].trim() : report.reporter;
                    const reporterPlayerId = reporterMatch ? reporterMatch[2] : '';
                    reporterName.textContent = reporterPlayerName;
                    reporterId.textContent = reporterPlayerId;
                    reporterIdLine.style.display = reporterMatch ? 'block' : 'none';
                    const reporterNameTagLabel = popup.querySelector('#report_popup_reporter_name_label');
                    const reporterNameTagWrap = popup.querySelector('#report_popup_reporter_name_tag_wrap');
                    const reporterNameVisible = updatePopupNameBadge(reporterNameTagLabel, reporterPlayerId);
                    if (reporterNameTagWrap) reporterNameTagWrap.style.display = reporterNameVisible ? 'flex' : 'none';

                    reason.innerText = report.reason;
                    const hasMultipleReasons = /,|;|\/|\s+&\s+|\s+and\s+/i.test(report.reason);
                    reportPopupReasonCount = String(report.reason).split(/,|;|\/|\s+&\s+|\s+and\s+/i).filter(part => part.trim()).length;
                    reportPopupReasonRequiredWidth = 0;
                    reason.style.fontSize = hasMultipleReasons ? '' : '1.1em';

                    if (successFadeTimeout) clearTimeout(successFadeTimeout);
                    if (reactionStatus) {
                        reactionStatus.style.opacity = '0';
                        reactionStatus.style.display = 'none';
                    }
                    updateQuickReactionButtons(report.id);
                    overlay.style.display = 'block';
                    popup.style.display = 'flex';
                    refreshOpenPopupGithubTags();
                    refreshOpenPopupModerationTags();
                    keepReportPopupSize();
                    fitReportPopupReason(reason);
                    if (!githubPlayerTags.size || Date.now() - lastGithubTagUpdate > 120000) {
                        loadGithubPlayerTags();
                    }
                });

                const joinBtn = reportRow.querySelector('.ss-auto-join-btn');
                if (joinBtn) joinBtn.addEventListener('click', () => doAutoJoin(report.server));
                const observeBtn = reportRow.querySelector('.ss-observe-btn');
                if (observeBtn) observeBtn.addEventListener('click', () => {
                    if (report.link) window.open(report.link, '_blank');
                    else alert("No observation link available.");
                });

                list.appendChild(reportRow);
            });
        }

        const initReportsPanel = setInterval(() => {
            const asideWrap = document.querySelector('.secondary-aside-wrap');
            const existingPanel = asideWrap?.querySelector(':scope > #custom-reports-panel');
            if (existingPanel) ensureReportsDiscordIcon(existingPanel);

            if (asideWrap && !existingPanel) {
                injectPopup();
                fetchDiscordReports();

                const reportsBox = document.createElement('div');
                reportsBox.id = "custom-reports-panel";
                reportsBox.className = "media-tabs-wrapper box_relative border-blue5 roundme_sm bg_blue6 common-box-shadow ss_margintop_sm";
                reportsBox.innerHTML = `
                    <div class="media-tab-container display-grid align-items-center gap-sm bg_blue3">
                        <h4 class="common-box-shadow text-shadow-black-40 text_white ss-report-header" style="display: flex; justify-content: space-between; align-items: center; width: 100%; margin: 0;">
                            <div class="ss-report-heading-group">
                                <div class="clickme" id="ss-reports-view-toggle" style="font-size: 1em; cursor: pointer;" title="Switch between Reports and Action taken">Reports</div>
                                <span id="ss-reports-count" class="ss-action-count" role="button" tabindex="0" aria-label="View Action taken" title="View Action taken"></span>
                                <i id="ss-reports-discord-copy" class="fab fa-discord" role="button" tabindex="0" aria-label="Copy Discord Token" title="Copy Discord Token"></i>
                                <span id="ss-action-count" class="ss-action-count" role="button" tabindex="0" aria-label="View Reports" title="View Reports"></span>
                            </div>
                            <div style="display: flex; align-items: center; gap: 6px; cursor: pointer;" id="ss-refresh-trigger" title="Force Refresh">
                                <span id="ss-reports-updated" class="text_white" style="font-size: 0.5em; font-weight: 700; font-family: sans-serif; opacity: 0.7; letter-spacing: 0.5px;">Waiting...</span>
                                <i class="fas fa-sync-alt text_white" id="ss-refresh-icon" style="font-size: 0.6em; opacity: 0.9;"></i>
                            </div>
                        </h4>
                    </div>
                    <div class="media-tabs-content f_col">
                        <div class="tab-content">
                            <div class="news-container f_row overflow-hidden" style="max-height: 250px; overflow-y: auto; overflow-x: hidden;">
                                <div class="player-challenges-aside box_relative bg_blue6 home-screen" style="width: 100%;">
                                    <section id="ss-reports-list" class="player-challenges-container overflow-hidden" style="display: flex; flex-direction: column;">
                                        <div id="ss-reports-placeholder" style="padding: 15px; color: #0c576f; font-weight: 700; text-align: center; font-size: 0.8em; word-break: break-all;">
                                            Fetching Discord...
                                        </div>
                                    </section>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                asideWrap.appendChild(reportsBox);
                const viewHeading = reportsBox.querySelector('#ss-reports-view-toggle');
                if (viewHeading) {
                    viewHeading.innerText = reportsView === 'reports' ? 'Reports' : 'Action taken';
                    viewHeading.classList.toggle('ss-action-view', reportsView === 'action');
                }
                updateLogCounters(reportsArray);
                if (reportsArray.length) renderReportsList(reportsArray);
                updateTimeText();

                const parentVisualScale = () => {
                    const width = asideWrap.offsetWidth;
                    return width ? asideWrap.getBoundingClientRect().width / width : 1;
                };
                let lastReportUnit = null;
                const keepReportTextSize = () => {
                    const browserZoom = window.outerWidth > 0 && window.innerWidth > 0
                        ? window.outerWidth / window.innerWidth
                        : window.devicePixelRatio || 1;
                    const viewportScale = window.visualViewport ? (window.visualViewport.scale || 1) : 1;
                    const scale = browserZoom * viewportScale * parentVisualScale();
                    if (!Number.isFinite(scale) || scale <= 0) return;
                    const unit = 1 / scale;
                    if (lastReportUnit === null || Math.abs(lastReportUnit - unit) > 0.001) {
                        reportsBox.style.setProperty('--ss-report-unit', `${unit}px`);
                        lastReportUnit = unit;
                    }
                };
                keepReportTextSize();
                window.addEventListener('resize', keepReportTextSize);
                if (window.visualViewport) window.visualViewport.addEventListener('resize', keepReportTextSize);

                document.getElementById('ss-reports-view-toggle').addEventListener('click', () => {
                    reportsView = reportsView === 'reports' ? 'action' : 'reports';
                    const heading = document.getElementById('ss-reports-view-toggle');
                    if (heading) {
                        heading.innerText = reportsView === 'reports' ? 'Reports' : 'Action taken';
                        heading.classList.toggle('ss-action-view', reportsView === 'action');
                    }
                    renderReportsList(reportsArray);
                });

                const switchToLog = view => {
                    if (reportsView === view) return;
                    reportsView = view;
                    const heading = document.getElementById('ss-reports-view-toggle');
                    if (heading) {
                        heading.innerText = reportsView === 'reports' ? 'Reports' : 'Action taken';
                        heading.classList.toggle('ss-action-view', reportsView === 'action');
                    }
                    renderReportsList(reportsArray);
                };
                [
                    [reportsBox.querySelector('#ss-reports-count'), 'action'],
                    [reportsBox.querySelector('#ss-action-count'), 'reports']
                ].forEach(([badge, destination]) => {
                    if (!badge) return;
                    badge.addEventListener('click', () => switchToLog(destination));
                    badge.addEventListener('keydown', event => {
                        if (event.key === 'Enter' || event.key === ' ') {
                            event.preventDefault();
                            switchToLog(destination);
                        }
                    });
                });

                ensureReportsDiscordIcon(reportsBox);

                document.getElementById('ss-refresh-trigger').addEventListener('click', () => {
                    const icon = document.getElementById('ss-refresh-icon');
                    if (icon) {
                        icon.classList.remove('ss-spin-once');
                        void icon.offsetWidth;
                        icon.classList.add('ss-spin-once');
                    }
                    fetchDiscordReports();
                    loadGithubLinkHub(true);
                    loadReportTagDefinitions();
                    modChatController?.refresh();
                });

                const syncReportsVisibility = () => {
                    if (!reportsBox.isConnected) return;
                    const nativeChallenges = asideWrap.querySelector(
                        ':scope > div:not(.house-small):not(#custom-reports-panel) > .media-tabs-wrapper'
                    );
                    let visible = !!nativeChallenges;
                    let opacity = 1;

                    if (nativeChallenges) {
                        for (let element = nativeChallenges; element && element !== asideWrap; element = element.parentElement) {
                            const computed = getComputedStyle(element);
                            if (computed.display === 'none' || computed.visibility === 'hidden' || computed.visibility === 'collapse') {
                                visible = false;
                                break;
                            }
                            const elementOpacity = Number.parseFloat(computed.opacity);
                            if (Number.isFinite(elementOpacity)) opacity *= elementOpacity;
                        }
                        if (visible) {
                            const bounds = nativeChallenges.getBoundingClientRect();
                            visible = bounds.width > 0 && bounds.height > 0;
                        }
                    }

                    const display = visible ? 'block' : 'none';
                    if (reportsBox.style.display !== display) reportsBox.style.display = display;
                    if (visible) {
                        const nativeOpacity = String(Math.max(0, Math.min(1, opacity)));
                        if (reportsBox.style.opacity !== nativeOpacity) reportsBox.style.opacity = nativeOpacity;
                        keepReportTextSize();
                    }
                    requestAnimationFrame(syncReportsVisibility);
                };
                syncReportsVisibility();
            }
        }, 500);

};
