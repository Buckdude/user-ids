        async function copyReportBadgeText(value) {
            try {
                if (!navigator.clipboard?.writeText) throw new Error('Clipboard unavailable');
                await navigator.clipboard.writeText(value);
            } catch (_) {
                const field = document.createElement('textarea');
                field.value = value;
                field.style.position = 'fixed';
                field.style.opacity = '0';
                document.body.appendChild(field);
                field.select();
                document.execCommand('copy');
                field.remove();
            }
        }

        function advanceReportBadgeSwitch(tag, playerId) {
            const key = `${playerId}:${tag.key}`;
            const custom = tag.clickAction === 'switch' && tag.clickValue
                ? tag.clickValue.split('~').map(text => text.trim()).filter(Boolean) : [];
            const count = custom.length ? custom.length + 1 : 2;
            reportBadgeSwitches.set(key, ((reportBadgeSwitches.get(key) || 0) + 1) % count);
            document.querySelectorAll('.ss-report-config-badge').forEach(other => {
                if (other.dataset.ssPlayerId !== playerId || other.dataset.ssTagKey !== tag.key) return;
