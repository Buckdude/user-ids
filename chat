        if (!name) return null;
        const roles = new Set(player.tags);
        const role = tagDefinitions.find(tag => !tag.nameGroup && tag.key !== 'time' &&
            (roles.has(tag.key) || (ROLE_ALIASES[tag.key] || []).some(alias => roles.has(alias)))) || null;
        const nameTag = tagDefinitions.find(tag => tag.nameGroup && tag.key !== 'name' && roles.has(tag.key)) ||
            tagDefinitions.find(tag => tag.nameGroup && tag.key === 'name') ||
            { textColor: '#FFFFFF', backgroundColor: '#0C576F' };
        return { discordId: String(discordId), playerId: player.playerId, name, role,
            links: player.links, verifiedLinkSpecified: Object.prototype.hasOwnProperty.call(verified, 'link'),
            verifiedLink: verified.link,
            nameTag: { ...nameTag,
                textColor: /^#(?:[0-9a-f]{3}|[0-9a-f]{6})$/i.test(verified.text_color || verified.textColor || '')
