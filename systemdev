                'border-top-left-radius', 'border-top-right-radius',
                'border-bottom-right-radius', 'border-bottom-left-radius'
            ];
            const pixelValue = /^-?\d+(?:\.\d+)?px$/;
            for (const element of popup.querySelectorAll('*')) {
                const computed = getComputedStyle(element);
                for (const property of sizingProperties) {
                    const value = computed.getPropertyValue(property).trim();
                    if (pixelValue.test(value)) element.style.setProperty(property, value);
                }
                if (element.matches('button')) {
                    const width = computed.getPropertyValue('width').trim();
                    if (pixelValue.test(width) && Number.parseFloat(width) > 0) {
                        element.style.setProperty('width', width);
                    }
                    for (const property of ['min-width', 'max-width', 'min-height', 'max-height']) {
                        const value = computed.getPropertyValue(property).trim();
                        if (pixelValue.test(value)) element.style.setProperty(property, value);
                    }
                }
            }
            lockedReportPopupContents.add(popup);
