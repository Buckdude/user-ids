globalThis.__SS_LIVE_REPORTS_START__ = function startShellReports(discordRequest, quickEmojis, resolvedEmojis) {
        'use strict';

        const CHANNEL_ID = "1126624154515406948";

        let lastUpdateTime = Date.now();
        window.currentSelectedReport = null;
        let successFadeTimeout = null;
        const reactionCache = {};
        const reactionConfirmed = {};
        const reactionPending = new Set();
        let reportsArray = [];
        let reportsView = 'reports';
        const REPORT_SESSION_KEY = `ss-live-reports-${CHANNEL_ID}-temporary-state`;
        function loadTemporaryReportState() {
            try {
                const state = JSON.parse(sessionStorage.getItem(REPORT_SESSION_KEY) || '{}');
                return state && typeof state === 'object' ? state : {};
            } catch (e) {
                return {};
            }
        }
        const temporaryReportState = loadTemporaryReportState();
        const recentReportCounts = new Map(
            Object.entries(temporaryReportState.recentCounts || {}).filter(([, count]) =>
                /^\d+$/.test(String(count)))
        );
        function saveTemporaryReportState() {
            try {
                sessionStorage.setItem(REPORT_SESSION_KEY, JSON.stringify({
                    recentCounts: Object.fromEntries(recentReportCounts)
                }));
            } catch (e) {
            }
        }
        function getOriginalRecentReportCount(messageId, count) {
            if (recentReportCounts.has(messageId)) return recentReportCounts.get(messageId);
            const originalCount = String(count);
            recentReportCounts.set(messageId, originalCount);
            saveTemporaryReportState();
            return originalCount;
        }

        const GITHUB_LINKS_URL = 'https://raw.githubusercontent.com/Buckdude/user-ids/refs/heads/main/admin';
        const GITHUB_REPORT_TAGS_LINKS_URL = 'https://raw.githubusercontent.com/Buckdude/user-ids/refs/heads/main/admin';
        const GITHUB_LINKS_CACHE_KEY = 'ss-live-reports-links-hub';
        const GITHUB_REFRESH_MS = 5000;
        const GITHUB_PLAYER_REFRESH_MS = 3000;
        const GITHUB_VERIFIED_REFRESH_MS = 3000;
        const GITHUB_MODERATION_REFRESH_MS = 10000;
        let githubLinkHub = null;
        let githubLinkHubLoading = false;
        let githubLinksWarningShown = false;
        let lastModerationRefresh = 0;
        let lastTagRefresh = 0;

        const WHITELISTED_PLAYER_IDS = new Set();
        const KNOWN_CHEATER_NAMES = new Set();
        const KNOWN_CHEATER_PLAYER_IDS = new Set();
        const BOT_NAMES = new Set();
        const TOXIC_NAMES = new Set();
        const TOXIC_PLAYER_IDS = new Set();
        const GITHUB_BWD_MEMBER_IDS = new Set();
        let moderationRequestGeneration = 0;

        function loadGitHubModerationTextList(url, targetSet, numericIds, listName) {
            if (!/^https:\/\//i.test(url)) return;
            const generation = moderationRequestGeneration;
            const urlWithRefresh = `${url}${url.includes('?') ? '&' : '?'}refresh=${Date.now()}`;
            GM_xmlhttpRequest({
                method: 'GET',
                url: urlWithRefresh,
                timeout: 15000,
                onload: response => {
                    if (generation !== moderationRequestGeneration) return;
                    if (response.status !== 200) {
                        console.warn(`[Reports] ${listName}: HTTP ${response.status}`);
                        return;
                    }
                    const next = new Set();
                    for (const rawLine of String(response.responseText ?? '').split(/\r?\n/)) {
                        const line = rawLine.trim();
                        if (!line || line.startsWith('#')) continue;
                        if (numericIds && !/^\d+$/.test(line)) {
                            console.warn(`[Reports] Invalid ${listName} ID:`, line);
                            continue;
                        }
                        next.add(numericIds ? line : line.toLowerCase());
                    }
                    targetSet.clear();
                    for (const entry of next) targetSet.add(entry);
                    renderReportsList(reportsArray);
                    refreshOpenPopupGithubTags();
                },
                onerror: () => console.warn(`[Reports] ${listName} failed`),
                ontimeout: () => console.warn(`[Reports] ${listName} timeout`)
            });
        }

        function refreshOpenPopupModerationTags() {
            const popup = document.getElementById('reportInfoPopup');
            const report = window.currentSelectedReport;
            if (!popup || popup.style.display === 'none' || !report) return;
            const reporterMatch = report.reporter.match(/^(.*?)\s*\[(\d+)\]\s*$/);
            const reporterName = reporterMatch ? reporterMatch[1].trim() : report.reporter;
            const reporterId = reporterMatch ? reporterMatch[2] : '';
            renderPopupRoleTags(popup.querySelector('#report_popup_user_tags'), report.name, report.pid);
            renderPopupRoleTags(popup.querySelector('#report_popup_reporter_tags'), reporterName, reporterId);
            keepReportPopupSize();
        }

        function loadGitHubToxicList() {
            if (!/^https:\/\//i.test(githubLinkHub?.GITHUB_TOXIC_URL || '')) return;
            const generation = moderationRequestGeneration;
            const urlWithRefresh = `${githubLinkHub.GITHUB_TOXIC_URL}${githubLinkHub.GITHUB_TOXIC_URL.includes('?') ? '&' : '?'}refresh=${Date.now()}`;
            GM_xmlhttpRequest({
                method: 'GET',
                url: urlWithRefresh,
                timeout: 15000,
                onload: response => {
                    if (generation !== moderationRequestGeneration) return;
                    if (response.status !== 200) {
                        console.warn(`[Reports] toxic: HTTP ${response.status}`);
                        return;
                    }
                    const nextNames = new Set();
                    const nextIds = new Set();
                    let section = null;
                    for (const rawLine of String(response.responseText ?? '').split(/\r?\n/)) {
                        const entry = rawLine.trim();
                        if (!entry || entry.startsWith('#')) continue;
                        if (/^\[ids\]$/i.test(entry)) {
                            section = 'ids';
                            continue;
                        }
                        if (/^\[usernames\]$/i.test(entry)) {
                            section = 'usernames';
                            continue;
                        }
                        if (/^\[[^\]]+\]$/.test(entry)) {
                            console.warn('[Reports] Invalid toxic section:', entry);
                            section = 'unknown';
                            continue;
                        }
                        if (section === 'unknown') continue;
                        if (section === 'usernames') {
                            nextNames.add(entry.toLowerCase());
                        } else if (section === 'ids') {
                            if (/^\d+$/.test(entry)) nextIds.add(entry);
                            else console.warn('[Reports] Invalid toxic ID:', entry);
                        } else {
                            if (/^\d+$/.test(entry)) nextIds.add(entry);
                            else nextNames.add(entry.toLowerCase());
                        }
                    }
                    TOXIC_NAMES.clear();
                    TOXIC_PLAYER_IDS.clear();
                    for (const name of nextNames) TOXIC_NAMES.add(name);
                    for (const id of nextIds) TOXIC_PLAYER_IDS.add(id);
                    renderReportsList(reportsArray);
                    refreshOpenPopupModerationTags();
                },
                onerror: () => console.warn('[Reports] toxic failed'),
                ontimeout: () => console.warn('[Reports] toxic timeout')
            });
        }

        function loadGitHubModerationLists() {
            moderationRequestGeneration++;
            loadGitHubModerationTextList(githubLinkHub?.GITHUB_WHITELIST_URL, WHITELISTED_PLAYER_IDS, true, 'whitelist');
            loadGitHubModerationTextList(githubLinkHub?.GITHUB_CHEATER_IDS_URL, KNOWN_CHEATER_PLAYER_IDS, true, 'cheater IDs');
            loadGitHubModerationTextList(githubLinkHub?.GITHUB_KNOWN_CHEATER_NAMES_URL, KNOWN_CHEATER_NAMES, false, 'known cheater names');
            loadGitHubModerationTextList(githubLinkHub?.GITHUB_BOTS_URL, BOT_NAMES, false, 'bot names');
            loadGitHubModerationTextList(githubLinkHub?.GITHUB_BWD_MEMBER_URL, GITHUB_BWD_MEMBER_IDS, true, 'BWD member IDs');
            loadGitHubToxicList();
        }

        let githubPlayerTags = new Map();
        let lastGithubTagUpdate = 0;
        let githubTagsLoading = false;
        let githubTagsLoadingUrl = '';
        const getGithubTagsCacheKey = () => 'ss-live-reports-tag-data:' + encodeURIComponent(githubLinkHub?.GITHUB_USER_TAGS_URL || '');
        let githubNameTagsEnabled = false;
        let githubPlayerDataSignature = '';

        let githubVerifiedPlayers = new Map();
        let githubVerifiedDataSignature = '';
        let githubVerifiedLoading = false;
        let githubVerifiedLoadingUrl = '';
        const getGithubVerifiedCacheKey = () => 'ss-live-reports-verified-names:' + encodeURIComponent(githubLinkHub?.GITHUB_VERIFIED_URL || '');

        function getGithubVerifiedName(playerId) {
            return githubVerifiedPlayers.get(String(playerId ?? '').trim()) || null;
        }

        function applyGithubVerifiedNames(data) {
            if (!data || !data.players || typeof data.players !== 'object' || Array.isArray(data.players))
                throw new Error('Expected verified JSON with a players object');
            const next = new Map();
            const validHex = /^#(?:[0-9a-f]{3}|[0-9a-f]{6})$/i;
            for (const [pid, entry] of Object.entries(data.players)) {
                if (!/^\d+$/.test(pid) || !entry || typeof entry !== 'object' || Array.isArray(entry)) continue;
                const color = String(entry.text_color ?? entry.textColor ?? '').trim();
                const background = String(entry.background_color ?? entry.backgroundColor ?? '').trim();
                if ((color && !validHex.test(color)) || (background && !validHex.test(background)))
                    throw new Error('Invalid verified name color for player ' + pid);
                const linkSpecified = Object.prototype.hasOwnProperty.call(entry, 'link');
                const rawLink = typeof entry.link === 'string' ? entry.link.trim() : '';
                let link = '';
                if (rawLink) {
                    const url = new URL(rawLink);
                    if (!['https:', 'http:'].includes(url.protocol)) throw new Error('Invalid verified link for ' + pid);
                    link = url.href;
                }
                const rawDiscordId = String(entry.discord_id ?? entry.discordId ?? '').trim();
                const discordId = /^\d+$/.test(rawDiscordId) ? rawDiscordId : '';
                const tags = Array.isArray(entry.tags)
                    ? entry.tags.filter(tag => typeof tag === 'string').map(tag => tag.trim().toLowerCase()).filter(Boolean)
                    : [];
                next.set(pid, {
                    name: typeof entry.name === 'string' ? entry.name.trim() : '',
                    nickname: typeof entry.nickname === 'string' ? entry.nickname.trim() : '',
                    hasName: Object.prototype.hasOwnProperty.call(entry, 'name'),
                    hasNickname: Object.prototype.hasOwnProperty.call(entry, 'nickname'),
                    discordId, discordIdSpecified: Object.prototype.hasOwnProperty.call(entry, 'discord_id') ||
                        Object.prototype.hasOwnProperty.call(entry, 'discordId'),
                    tags, textColor: color, backgroundColor: background, link, linkSpecified
                });
            }
            const signature = JSON.stringify(Array.from(next.entries()));
            if (signature === githubVerifiedDataSignature) return false;
            githubVerifiedPlayers = next;
            githubVerifiedDataSignature = signature;
            reportBadgeSwitches.clear();
            restartReportBadgeFlashes();
            renderReportsList(reportsArray);
            refreshOpenPopupGithubTags();
            return true;
        }

        function restoreGithubVerifiedForCurrentUrl() {
            if (!githubLinkHub?.GITHUB_VERIFIED_URL) return;
            try {
                const cached = GM_getValue(getGithubVerifiedCacheKey(), '');
                if (cached) {
                    const data = JSON.parse(cached);
                    for (const entry of Object.values(data.players || {})) {
                        if (entry && typeof entry === 'object' && 'link' in entry) entry.link = '';
                    }
                    applyGithubVerifiedNames(data);
                }
            } catch (error) {
                console.warn('[Reports] Verified names cache invalid:', error);
            }
        }

        async function loadGithubVerifiedNames() {
            const requestedUrl = githubLinkHub?.GITHUB_VERIFIED_URL;
            if (!isGithubRawUrl(requestedUrl) || (githubVerifiedLoading && githubVerifiedLoadingUrl === requestedUrl)) return;
            githubVerifiedLoading = true;
            githubVerifiedLoadingUrl = requestedUrl;
            try {
                const raw = await readGithubHubText(requestedUrl);
                if (githubLinkHub?.GITHUB_VERIFIED_URL !== requestedUrl) return;
                const data = raw.trim() ? JSON.parse(raw) : { players: {} };
                const changed = applyGithubVerifiedNames(data);
                GM_setValue(getGithubVerifiedCacheKey(), JSON.stringify(data));
            } catch (error) {
                if (githubLinkHub?.GITHUB_VERIFIED_URL === requestedUrl) {
                    if (/HTTP 404/.test(String(error.message || error))) {
                        applyGithubVerifiedNames({ players: {} });
                        try { GM_setValue(getGithubVerifiedCacheKey(), JSON.stringify({ players: {} })); } catch (_) {}
                    }
                    console.warn('[Reports] /verified refresh:', error.message || error);
                }
            } finally {
                githubVerifiedLoading = false;
            }
        }


        function getGithubPlayer(playerId) {
            const id = String(playerId ?? '').trim();
            const user = githubPlayerTags.get(id) || null;
            const verified = githubVerifiedPlayers.get(id) || null;
            if (!verified) return user;
            if (!user) return {
                name: verified.name, nickname: verified.nickname,
                tags: verified.tags, discordId: verified.discordId, links: Object.create(null)
            };
            return {
                ...user,
                name: verified.name || user.name,
                nickname: verified.nickname || user.nickname,
                discordId: verified.discordIdSpecified ? verified.discordId : user.discordId,
                tags: user.tags
            };
        }

        function applyGithubPlayerTags(data) {
            if (!data || !data.players || typeof data.players !== 'object' || Array.isArray(data.players)) {
                throw new Error('Expected a JSON object with a "players" field');
            }
            const next = new Map();
            for (const [pid, entry] of Object.entries(data.players)) {
                if (!/^\d+$/.test(pid) || !entry || typeof entry !== 'object' || Array.isArray(entry)) continue;
                const name = typeof entry.name === 'string' ? entry.name.trim() : '';
                const nickname = typeof entry.nickname === 'string' ? entry.nickname.trim() : '';
                const rawDiscordId = String(entry.discord_id ?? entry.discordId ?? '').trim();
                const discordId = /^\d+$/.test(rawDiscordId) ? rawDiscordId : '';
                const tags = Array.isArray(entry.tags)
                    ? entry.tags.filter(tag => typeof tag === 'string').map(tag => tag.trim().toLowerCase()).filter(Boolean)
                    : [];
                const links = Object.create(null);
                if (entry.links && typeof entry.links === 'object' && !Array.isArray(entry.links)) {
                    for (const [rawKey, rawUrl] of Object.entries(entry.links)) {
                        const key = rawKey.trim().toLowerCase();
                        if (!/^[a-z][a-z0-9_]*$/.test(key) || typeof rawUrl !== 'string') continue;
                        try {
                            const url = new URL(rawUrl.trim());
                            if (url.protocol === 'https:' || url.protocol === 'http:') links[key] = url.href;
                        } catch (_) {}
                    }
                }
                if (!name && !nickname && tags.length === 0) continue;
                next.set(pid, { name, nickname, tags, discordId, links });
            }
            const signature = JSON.stringify(Array.from(next.entries()));
            if (signature === githubPlayerDataSignature) return false;
            githubNameTagsEnabled = Array.from(next.values()).some(entry => !!(entry.name || entry.nickname));
            githubPlayerTags = next;
            githubPlayerDataSignature = signature;
            lastGithubTagUpdate = Date.now();
            renderReportsList(reportsArray);
            refreshOpenPopupGithubTags();
            return true;
        }

        function restoreGithubTagsForCurrentUrl() {
            if (!githubLinkHub?.GITHUB_USER_TAGS_URL) return;
            try {
                const stored = GM_getValue(getGithubTagsCacheKey(), '');
                if (stored) {
                    const data = JSON.parse(stored);
                    for (const entry of Object.values(data.players || {})) {
                        if (entry && typeof entry === 'object') delete entry.links;
                    }
                    applyGithubPlayerTags(data);
                }
            } catch (error) {
                console.warn('[Reports] Tag cache invalid:', error);
            }
        }

        function getGithubNameTag(playerId) {
            const entry = getGithubPlayer(playerId);
            return entry ? (entry.nickname || entry.name || '') : '';
        }

        function getGithubDiscordId(playerId) {
            return getGithubPlayer(playerId)?.discordId || '';
        }

        function getGithubPlayerBadgeLink(playerId, tag) {
            if (!tag) return '';
            const links = getGithubPlayer(playerId)?.links;
            const exactLink = links?.[tag.key] || '';
            const aliasLink = tag.key === 'league' ? (links?.leaguerep || '') :
                tag.key === 'leaguerep' ? (links?.league || '') : '';
            if (!tag.isNameGroup) return exactLink || aliasLink;
            const verified = getGithubVerifiedName(playerId);
            if (verified?.linkSpecified) return verified.link;
            return exactLink || links?.name || '';
        }

        function hasGithubRole(playerId, role) {
            const entry = getGithubPlayer(playerId);
            if (!entry) return false;
            if (role === 'cc') return entry.tags.includes('cc') || entry.tags.includes('creator') || entry.tags.includes('content creator');
            if (role === 'member') return entry.tags.includes('member') || entry.tags.includes('bwd member');
            if (role === 'excc') return ['excc', 'ex_cc', 'ex_content_creator', 'ex content creator'].some(tag => entry.tags.includes(tag));
            if (role === 'mod') return ['mod', 'community_mod', 'communitymod', 'community mod'].some(tag => entry.tags.includes(tag));
            if (role === 'league') return ['league', 'league_rep', 'leaguerep', 'league rep'].some(tag => entry.tags.includes(tag));
            if (role === 'archwizard') return ['archwizard', 'arch_wizard'].some(tag => entry.tags.includes(tag));
            if (role === 'leaguemod') return ['leaguemod', 'league_mod'].some(tag => entry.tags.includes(tag));
            return entry.tags.includes(role);
        }

        function isScriptDevPlayer(playerId) {
            return hasGithubRole(playerId, 'developer') ||
                hasGithubRole(playerId, 'dev') ||
                hasGithubRole(playerId, 'script_dev');
        }

        function isWizardPlayer(playerId) {
            return hasGithubRole(playerId, 'wizard');
        }

        const DEFAULT_REPORT_TAG_LINES = [
            'script_dev | SCRIPT DEV | DEV | #C2FBBF | #000000',
            'wizard | WIZARD | WIZARD | #FFFFFF | #3498DB',
            'archwizard | ARCHWIZARD | ARCHWIZARD | #FFFFFF | #206694',
            'mod | BWD MOD | MOD | #FFFFFF | #0029FF',
            'eggforcer | EGGFORCER | EGGFORCER | #FFFFFF | #71368A',
            'leaguemod | LEAGUE MOD | LEAGUE MOD | #FFFFFF | #05800C',
            'league | LEAGUE REP | LEAGUE | #FFFFFF | #006105',
            'ccmod | CONTENT CREATOR MOD | CC MOD | #FFFFFF | #9E6BFF',
            'cc | CONTENT CREATOR | CC | #FFFFFF | #E91E63',
            'excc | EX CONTENT CREATOR | EX CC | #FFFFFF | #AB1045',
            'member | BWD MEMBER | MEMBER | #FFFFFF | #3F51B5',
            'cheater | CHEATER | CHEATER | #FFFFFF | #900100',
            'bot | BOT | BOT | #FFFFFF | #900100',
            'toxic | TOXIC | TOXIC | #FFFFFF | #7B4A24',
            'verified | {name} | {name} | #FFFFFF | #AA3377 | 1',
            'name | {name} | {name} | #FFFFFF | #0C576F | 1',
        ];
        const GITHUB_REPORT_TAGS_CACHE_KEY = 'ss-live-reports-custom-tag-definitions';
        const REPORT_TAGS_REFRESH_MS = 5000;
        let reportTagDefinitionsLoading = false;

        function parseReportTagDefinitions(source) {
            const parsed = [];
            const used = new Set();
            for (const raw of String(source).split(/\r?\n/)) {
                const line = raw.trim();
                if (!line || line.startsWith('#')) continue;
                const values = line.split('|').map(value => value.trim());
                if (values.length < 5 || values.length > 9) throw new Error('Tag must have 5 to 9 fields: ' + line);
                while (values.length < 9) values.push('');
                const [key, popupName, logName, textColor, backgroundColor, rawAction, rawClickValue, flashField, flashSeconds] = values;
                const directUrl = /^https?:\/\//i.test(rawAction);
                const valueUrl = !rawAction && /^https?:\/\//i.test(rawClickValue);
                const nameModeOff = rawAction === '1';
                const nameModeToggle = /^2(?:\s*\[name\])?$/i.test(rawAction);
                const clickAction = directUrl || valueUrl ? 'link' :
                    (nameModeOff || nameModeToggle ? 'copyid' : rawAction.toLowerCase());
                const clickValue = directUrl ? rawAction : rawClickValue;
                const nameToggle = nameModeToggle || rawAction.toLowerCase() === 'switch';
                if (!/^[a-z][a-z0-9_]*$/.test(key)) throw new Error('Invalid tag key: ' + key);
                if (used.has(key)) throw new Error('Duplicate tag key: ' + key);
                if (!popupName || !logName || popupName.length > 80 || logName.length > 80)
                    throw new Error('Invalid tag label: ' + key);
                if ((popupName === '{name}') !== (logName === '{name}'))
                    throw new Error('Name group must use {name} in both popup and log: ' + key);
                if (key === 'name' && popupName !== '{name}')
                    throw new Error('The reserved name key must use {name}: ' + key);
                if (!/^#(?:[0-9a-f]{3}|[0-9a-f]{6})$/i.test(textColor) ||
                    !/^#(?:[0-9a-f]{3}|[0-9a-f]{6})$/i.test(backgroundColor))
                    throw new Error('Invalid hex color: ' + key);
                if (!['', 'none', 'link', 'copy', 'copyid', 'switch'].includes(clickAction))
                    throw new Error('Unknown click action for ' + key + ': ' + clickAction);
                if (directUrl && rawClickValue) throw new Error('Put the URL in CLICK or VALUE, not both: ' + key);
                if (clickValue.length > 600) throw new Error('Click value too long: ' + key);
                if (clickAction === 'link' && clickValue) {
                    try {
                        const link = new URL(clickValue);
                        if (!['https:', 'http:'].includes(link.protocol)) throw new Error('Invalid protocol');
                    } catch (_) { throw new Error('Link must be a valid HTTP(S) URL: ' + key); }
                }
                const flashColors = flashField ? flashField.split(',').map(color => color.trim()) : [];
                if (flashColors.length && (flashColors.length < 2 || flashColors.length > 20 ||
                    flashColors.some(color => !/^#(?:[0-9a-f]{3}|[0-9a-f]{6})$/i.test(color))))
                    throw new Error('Flash requires 2 to 20 hex colors: ' + key);
                const flashInterval = flashSeconds ? Number(flashSeconds) : 0.3;
                if (flashColors.length && (!Number.isFinite(flashInterval) || flashInterval < 0.05 || flashInterval > 30))
                    throw new Error('Flash seconds must be from 0.05 to 30: ' + key);
                parsed.push({ key, popupName, logName, textColor, backgroundColor,
                    isNameGroup: popupName === '{name}', clickAction, clickValue, nameToggle,
                    flashColors, flashInterval });
                used.add(key);
            }
            if (!parsed.length) throw new Error('No tags defined');
            return parsed;
        }

        let reportTagDefinitions = parseReportTagDefinitions(DEFAULT_REPORT_TAG_LINES.join('\n'));

        function getOrderedReportTagKeys(playerId) {
            return reportTagDefinitions.filter(tag => !tag.isNameGroup).map(tag => tag.key);
        }

        function getReportNameStyle(playerId) {
            const playerTags = getGithubPlayer(playerId)?.tags || [];
            const base = reportTagDefinitions.find(tag => tag.isNameGroup && tag.key !== 'name' && playerTags.includes(tag.key)) ||
                reportTagDefinitions.find(tag => tag.isNameGroup && tag.key === 'name') || null;
            const verified = getGithubVerifiedName(playerId);
            if (!verified) return base;
            const verifiedTag = reportTagDefinitions.find(tag => tag.key === 'verified' && tag.isNameGroup);
            const style = verifiedTag || base;
            if (!style) return null;
            return { ...style,
                textColor: verified.textColor || style.textColor,
                backgroundColor: verified.backgroundColor || style.backgroundColor };
        }

        const reportBadgeClickTimers = new WeakMap();
        const reportBadgeSwitches = new Map();
        const reportBadgeFlashStates = new Map();

        function getReportBadgeDefinition(key, playerId = '') {
            const tag = reportTagDefinitions.find(tag => tag.key === key) || null;
            if (tag?.isNameGroup || (key === 'name' && getGithubVerifiedName(playerId))) {
                const style = getReportNameStyle(playerId);
                if (style?.key === key) return style;
            }
            return tag;
        }

        function getReportBadgeBackground(tag, playerId = '', allowFlash = false) {
            const verifiedColor = tag.isNameGroup ? getGithubVerifiedName(playerId)?.backgroundColor : '';
            if (verifiedColor) return verifiedColor;
            const state = allowFlash ? reportBadgeFlashStates.get(tag.key) : null;
            return state ? state.colors[state.index] : tag.backgroundColor;
        }

        function restartReportBadgeFlashes() {
            for (const state of reportBadgeFlashStates.values()) clearInterval(state.timer);
            reportBadgeFlashStates.clear();
            const flashing = reportTagDefinitions.map(tag => ({ tag, key: tag.key }));
            for (const { tag, key } of flashing) {
                if (!tag.flashColors.length) continue;
                const state = { colors: tag.flashColors, index: 0, timer: null };
                reportBadgeFlashStates.set(key, state);
                state.timer = setInterval(() => {
                    state.index = (state.index + 1) % state.colors.length;
                    if (reportsView !== 'reports') return;
                    const list = document.querySelector('#custom-reports-panel #ss-reports-list.ss-report-flash-active');
                    const heading = document.querySelector('#custom-reports-panel #ss-reports-view-toggle');
                    if (!list || heading?.textContent.trim().toLowerCase() !== 'reports') return;
                    list.querySelectorAll('.ss-report-flash-eligible.ss-report-config-badge').forEach(badge => {
                        if (badge.dataset.ssTagKey !== tag.key || badge.closest('#reportInfoPopup')) return;
                        const pid = badge.dataset.ssPlayerId;
                        const style = tag.isNameGroup ? getReportNameStyle(pid) : tag;
                        if (style?.key === tag.key)
                            badge.style.setProperty('background', getReportBadgeBackground(style, pid, true), 'important');
                    });
                }, Math.round(tag.flashInterval * 1000));
            }
        }

        function canSwitchReportBadge(tag, playerId) {
            if (!tag) return false;
            if (!tag.isNameGroup) return tag.clickAction === 'switch' && !!tag.clickValue.trim();
            if (!tag.nameToggle && tag.clickAction !== 'switch') return false;
            const player = getGithubPlayer(playerId);
            const primary = getGithubNameTag(playerId);
            const alternates = tag.clickValue && tag.clickAction === 'switch'
                ? tag.clickValue.split('~').map(value => value.trim()).filter(Boolean) : [];
            return !!(alternates.length || (player?.name && primary && player.name !== primary));
        }

        function getReportBadgeText(tag, playerId, isPopup) {
            const player = getGithubPlayer(playerId);
            const primary = tag.isNameGroup ? getGithubNameTag(playerId) : (isPopup ? tag.popupName : tag.logName);
            if (!canSwitchReportBadge(tag, playerId)) return primary;
            let alternates = tag.clickAction === 'switch' && tag.clickValue
                ? tag.clickValue.split('~').map(text => text.trim()).filter(Boolean) : [];
            if (!alternates.length && tag.isNameGroup && player?.name && player.name !== primary) alternates = [player.name];
            const index = reportBadgeSwitches.get(`${playerId}:${tag.key}`) || 0;
            const values = [primary, ...alternates];
            return replaceReportBadgeTokens(values[index % values.length] || primary, playerId);
        }

        function replaceReportBadgeTokens(value, playerId) {
            const player = getGithubPlayer(playerId);
            const tokens = {
                '{name}': getGithubNameTag(playerId),
                '{nickname}': player?.nickname || player?.name || '',
                '{username}': player?.name || '',
                '{discord_id}': getGithubDiscordId(playerId),
                '{player_id}': String(playerId || '')
            };
            return String(value).replace(/\{(?:name|nickname|username|discord_id|player_id)\}/g, token => tokens[token] || '');
        }

        function getReportBadgeAction(tag, playerId) {
            if (!tag) return '';
            if (getGithubPlayerBadgeLink(playerId, tag)) return 'link';
            const verified = tag.isNameGroup ? getGithubVerifiedName(playerId) : null;
            if (verified?.linkSpecified && !verified.link && tag.clickAction === 'link')
                return getGithubDiscordId(playerId) ? 'copyid' : (canSwitchReportBadge(tag, playerId) ? 'switch' : '');
            if (!tag.clickAction || tag.clickAction === 'none') {
                if (tag.isNameGroup && getGithubDiscordId(playerId)) return 'copyid';
                return canSwitchReportBadge(tag, playerId) ? 'switch' : '';
            }
            if (tag.isNameGroup && tag.clickAction === 'switch' && getGithubDiscordId(playerId)) return 'copyid';
            if (tag.clickAction === 'copyid' && !getGithubDiscordId(playerId))
                return canSwitchReportBadge(tag, playerId) ? 'switch' : '';
            if (['copy', 'link'].includes(tag.clickAction) && !tag.clickValue)
                return canSwitchReportBadge(tag, playerId) ? 'switch' : '';
            if (tag.clickAction === 'switch' && !canSwitchReportBadge(tag, playerId)) return '';
            return tag.clickAction;
        }

        function getReportBadgeActionTitle(tag, playerId) {
            const action = getReportBadgeAction(tag, playerId);
            const changesName = tag?.isNameGroup && canSwitchReportBadge(tag, playerId);
            if (action === 'link') return changesName ? 'Open link and switch name' : 'Open link';
            if (action === 'copy') return changesName ? 'Copy text and switch name' : 'Click to copy';
            if (action === 'copyid') return changesName ? 'Copy Discord ID and switch name' : 'Click to copy Discord ID';
            return action === 'switch' ? (tag.isNameGroup ? 'Click to switch name' : 'Click to switch label') : '';
        }

        function getReportBadgeAttributes(tag, playerId) {
            const action = getReportBadgeAction(tag, playerId);
            const title = getReportBadgeActionTitle(tag, playerId);
            return ` data-ss-tag-key="${tag.key}" data-ss-player-id="${escapeGithubTag(playerId)}"` +
                (action ? ` title="${title}" role="button" tabindex="0"` : '');
        }

        function configureReportBadge(element, tag, playerId) {
            element.classList.add('ss-report-config-badge');
            element.dataset.ssTagKey = tag.key;
            element.dataset.ssPlayerId = String(playerId || '');
            const title = getReportBadgeActionTitle(tag, playerId);
            if (title) {
                element.title = title;
                element.setAttribute('role', 'button');
                element.setAttribute('tabindex', '0');
