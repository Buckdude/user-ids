        function updateTimeText() {
            const el = document.getElementById('ss-reports-updated');
            if (!el) return;
            const diff = Math.floor((Date.now() - lastUpdateTime) / 1000);
            if (diff < 5) el.innerText = "Just now";
            else if (diff < 60) el.innerText = `${diff}s ago`;
            else el.innerText = `${Math.floor(diff/60)}m ago`;
        }
        setInterval(updateTimeText, 1000);

        function doAutoJoin(serverCode) {
            if (!serverCode || serverCode === "Unknown") {
                alert("No server code available for this report.");
                return;
            }

            const script = document.createElement('script');
            script.textContent = "if (typeof vueApp !== 'undefined') vueApp.leaveGame();";
            document.body.appendChild(script);
            script.remove();

            const playWithFriendsBtn = document.querySelector('.btn_play_w_friends');
            if (playWithFriendsBtn) playWithFriendsBtn.click();

            const checkInput = setInterval(() => {
                const joinPanel = document.querySelector('.play-panel-panels-join');
                if (joinPanel) {
                    const inputField = joinPanel.querySelector('input.ss_field[placeholder="Enter your code"]');
                    const finalJoinBtn = joinPanel.querySelector('.ss_button_join');

                    if (inputField && finalJoinBtn) {
                        clearInterval(checkInput);
                        const nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, "value").set;
                        nativeInputValueSetter.call(inputField, serverCode);
                        inputField.dispatchEvent(new Event('input', { bubbles: true }));
                        setTimeout(() => finalJoinBtn.click(), 100);
                    }
                }
            }, 50);
            setTimeout(() => clearInterval(checkInput), 3000);
        }

