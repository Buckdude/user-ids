        } catch (_) { return ''; }
    }
    function getBadgeLink(tag, identity) {
        const links = identity.links || {};
        const exact = links[tag.key] || '';
        const alias = tag.key === 'league' ? (links.leaguerep || '') :
            tag.key === 'leaguerep' ? (links.league || '') : '';
        if (tag.nameGroup) {
            if (identity.verifiedLinkSpecified) return validExternalUrl(identity.verifiedLink);
            return validExternalUrl(exact || links.name);
        }
        return validExternalUrl(exact || alias);
    }
    function replaceBadgeTokens(value, identity) {
        const tokens = {
            '{name}': identity.name, '{nickname}': identity.name,
            '{username}': identity.name, '{discord_id}': identity.discordId,
            '{player_id}': identity.playerId
        };
